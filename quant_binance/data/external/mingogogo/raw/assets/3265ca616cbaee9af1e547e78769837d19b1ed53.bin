        // 변수 초기화
        let currentCategory = 'all';
        let usedCount = 0;
        let currentExcuse = '';
        let allExcuses = [];

        // 모든 핑계 평탄화
        function flattenExcuses() {
            allExcuses = [];
            let idx = 1;
            Object.entries(excusesDatabase).forEach(([cat, excuses]) => {
                excuses.forEach(excuse => {
                    allExcuses.push({
                        id: idx++,
                        category: cat,
                        text: excuse
                    });
                });
            });
        }

        // 카테고리 한글명
        const categoryNames = {
            all: '전체',
            health: '건강/의료',
            family: '가족',
            emergency: '긴급상황',
            transport: '교통',
            home: '집/주거',
            official: '공적업무',
            mental: '정신건강',
            pet: '반려동물',
            weather: '날씨/재해'
        };

        // 초기화
        flattenExcuses();
        renderExcuseList();
        createParticles();

        // 카테고리 버튼 이벤트
        document.querySelectorAll('.category-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.category-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                currentCategory = this.dataset.category;
                document.getElementById('currentCategory').textContent = currentCategory.toUpperCase();
                filterExcuseList();
            });
        });

        // 생성 버튼 이벤트
        document.getElementById('generateBtn').addEventListener('click', function() {
            generateExcuse(currentCategory);
        });

        // 랜덤 버튼 이벤트
        document.getElementById('randomBtn').addEventListener('click', function() {
            generateExcuse('all');
        });

        // 복사 버튼 이벤트
        document.getElementById('copyBtn').addEventListener('click', function() {
            if (currentExcuse) {
                navigator.clipboard.writeText(currentExcuse).then(() => {
                    showToast();
                });
            }
        });

        // 검색 이벤트
        document.getElementById('searchInput').addEventListener('input', function() {
            filterExcuseList(this.value);
        });

        // 핑계 생성 함수
        function generateExcuse(category) {
            let pool = category === 'all' ? allExcuses : allExcuses.filter(e => e.category === category);
            let selected = pool[Math.floor(Math.random() * pool.length)];
            
            currentExcuse = selected.text;
            usedCount++;
            
            // 애니메이션 효과
            const resultContainer = document.getElementById('resultContainer');
            resultContainer.style.transform = 'scale(0.95)';
            resultContainer.style.opacity = '0.5';
            
            setTimeout(() => {
                document.getElementById('resultNumber').textContent = `EXCUSE #${String(selected.id).padStart(3, '0')}`;
                document.getElementById('resultText').textContent = selected.text;
                document.getElementById('resultCategory').textContent = categoryNames[selected.category].toUpperCase();
                document.getElementById('usedCount').textContent = usedCount;
                
                resultContainer.style.transform = 'scale(1)';
                resultContainer.style.opacity = '1';
            }, 200);
        }

        // 핑계 리스트 렌더링
        function renderExcuseList() {
            const grid = document.getElementById('excuseGrid');
            grid.innerHTML = allExcuses.map(excuse => `
                <div class="excuse-item" data-category="${excuse.category}" onclick="selectExcuse(${excuse.id})">
                    <span class="excuse-num">#${String(excuse.id).padStart(3, '0')}</span>
                    <span class="excuse-text">${excuse.text}</span>
                </div>
            `).join('');
        }

        // 핑계 리스트 필터링
        function filterExcuseList(searchTerm = '') {
            const items = document.querySelectorAll('.excuse-item');
            items.forEach(item => {
                const matchCategory = currentCategory === 'all' || item.dataset.category === currentCategory;
                const matchSearch = !searchTerm || item.querySelector('.excuse-text').textContent.includes(searchTerm);
                item.style.display = matchCategory && matchSearch ? 'flex' : 'none';
            });
        }

        // 핑계 선택
        function selectExcuse(id) {
            const excuse = allExcuses.find(e => e.id === id);
            if (excuse) {
                currentExcuse = excuse.text;
                usedCount++;
                
                document.getElementById('resultNumber').textContent = `EXCUSE #${String(excuse.id).padStart(3, '0')}`;
                document.getElementById('resultText').textContent = excuse.text;
                document.getElementById('resultCategory').textContent = categoryNames[excuse.category].toUpperCase();
                document.getElementById('usedCount').textContent = usedCount;
                
                // 스크롤 업
                document.querySelector('.generator-section').scrollIntoView({ behavior: 'smooth' });
            }
        }

        // 토스트 표시
        function showToast() {
            const toast = document.getElementById('toast');
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 2500);
        }

        // 파티클 생성
        function createParticles() {
            const colors = ['#00f5ff', '#ff00ff', '#00ff88', '#ffd700'];
            for (let i = 0; i < 15; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.width = particle.style.height = Math.random() * 8 + 4 + 'px';
                particle.style.background = colors[Math.floor(Math.random() * colors.length)];
                particle.style.animationDelay = Math.random() * 15 + 's';
                particle.style.animationDuration = Math.random() * 10 + 15 + 's';
                document.body.appendChild(particle);
            }
        }
    </script>
</body>
</html>
