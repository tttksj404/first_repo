<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FARMING Excuse Generator | 파밍 현실적 핑계 시스템 v4.0</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Rajdhani:wght@300;400;500;600;700&family=Noto+Sans+KR:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --neon-cyan: #00f5ff;
            --neon-pink: #ff00ff;
            --neon-green: #00ff88;
            --neon-orange: #ff6b35;
            --neon-yellow: #ffd700;
            --neon-purple: #bf00ff;
            --dark-bg: #0a0a0f;
            --darker-bg: #050508;
            --card-bg: rgba(15, 15, 25, 0.85);
            --glass-border: rgba(255, 255, 255, 0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Noto Sans KR', 'Rajdhani', sans-serif;
            background: var(--dark-bg);
            color: #e8e8e8;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* 배경 애니메이션 */
        .bg-animation {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        .bg-animation::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(ellipse at 20% 20%, rgba(0, 245, 255, 0.15) 0%, transparent 50%),
                radial-gradient(ellipse at 80% 80%, rgba(255, 0, 255, 0.12) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 50%, rgba(0, 255, 136, 0.08) 0%, transparent 60%);
            animation: bgPulse 8s ease-in-out infinite;
        }

        @keyframes bgPulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.7; transform: scale(1.1); }
        }

        /* 그리드 패턴 */
        .grid-pattern {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            background-image: 
                linear-gradient(rgba(0, 245, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 245, 255, 0.03) 1px, transparent 1px);
            background-size: 50px 50px;
            animation: gridMove 20s linear infinite;
        }

        @keyframes gridMove {
            0% { transform: perspective(500px) rotateX(60deg) translateY(0); }
            100% { transform: perspective(500px) rotateX(60deg) translateY(50px); }
        }

        /* 메인 컨테이너 */
        .container {
            position: relative;
            z-index: 1;
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        /* 상단 SNS 링크 바 */
        .top-links {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
            padding: 25px 20px;
            background: linear-gradient(135deg, rgba(0, 245, 255, 0.08), rgba(255, 0, 255, 0.08));
            border-radius: 20px;
            border: 1px solid var(--glass-border);
            backdrop-filter: blur(20px);
            margin-bottom: 30px;
            animation: fadeInDown 0.8s ease-out;
        }

        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .sns-link {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            padding: 12px 18px;
            background: linear-gradient(145deg, rgba(20, 20, 35, 0.9), rgba(10, 10, 20, 0.9));
            border-radius: 14px;
            border: 1px solid rgba(0, 245, 255, 0.2);
            text-decoration: none;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            min-width: 90px;
        }

        .sns-link:hover {
            transform: translateY(-8px) scale(1.05);
            border-color: var(--neon-cyan);
            box-shadow: 
                0 15px 40px rgba(0, 245, 255, 0.3),
                0 0 30px rgba(0, 245, 255, 0.2),
                inset 0 0 20px rgba(0, 245, 255, 0.1);
        }

        .sns-icon {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            font-size: 20px;
            font-weight: 700;
            background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple));
            color: var(--dark-bg);
            transition: all 0.3s ease;
        }

        .sns-link:hover .sns-icon {
            transform: rotate(360deg) scale(1.1);
        }

        .sns-name {
            font-size: 11px;
            font-weight: 600;
            color: #b8b8c8;
            letter-spacing: 0.5px;
        }

        /* 메인 헤더 */
        .main-header {
            text-align: center;
            padding: 50px 20px;
            margin-bottom: 40px;
            position: relative;
        }

        .main-title {
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(2rem, 5vw, 3.5rem);
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 6px;
            margin-bottom: 15px;
            background: linear-gradient(135deg, var(--neon-cyan), var(--neon-pink), var(--neon-green));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: titleGlow 3s ease-in-out infinite;
            text-shadow: 0 0 60px rgba(0, 245, 255, 0.5);
        }

        @keyframes titleGlow {
            0%, 100% { filter: brightness(1) drop-shadow(0 0 20px rgba(0, 245, 255, 0.5)); }
            50% { filter: brightness(1.3) drop-shadow(0 0 40px rgba(255, 0, 255, 0.7)); }
        }

        .sub-title {
            font-family: 'Rajdhani', sans-serif;
            font-size: clamp(1rem, 2.5vw, 1.4rem);
            font-weight: 500;
            color: #8888aa;
            letter-spacing: 8px;
            text-transform: uppercase;
        }

        /* 생성기 메인 영역 */
        .generator-section {
            background: var(--card-bg);
            border-radius: 30px;
            border: 1px solid var(--glass-border);
            padding: 50px 40px;
            margin-bottom: 40px;
            backdrop-filter: blur(30px);
            position: relative;
            overflow: hidden;
        }

        .generator-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--neon-cyan), var(--neon-pink), var(--neon-green), var(--neon-cyan));
            background-size: 300% 100%;
            animation: gradientMove 4s linear infinite;
        }

        @keyframes gradientMove {
            0% { background-position: 0% 50%; }
            100% { background-position: 300% 50%; }
        }

        /* 카테고리 선택 버튼 */
        .category-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 15px;
            margin-bottom: 40px;
        }

        .category-btn {
            padding: 18px 15px;
            border: 2px solid rgba(0, 245, 255, 0.3);
            background: linear-gradient(145deg, rgba(20, 20, 40, 0.8), rgba(10, 10, 25, 0.8));
            border-radius: 16px;
            color: #c8c8d8;
            font-family: 'Noto Sans KR', sans-serif;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            overflow: hidden;
        }

        .category-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(0, 245, 255, 0.2), transparent);
            transition: left 0.5s ease;
        }

        .category-btn:hover::before {
            left: 100%;
        }

        .category-btn:hover, .category-btn.active {
            border-color: var(--neon-cyan);
            color: var(--neon-cyan);
            transform: translateY(-5px);
            box-shadow: 
                0 10px 30px rgba(0, 245, 255, 0.25),
                0 0 20px rgba(0, 245, 255, 0.15);
        }

        .category-btn.active {
            background: linear-gradient(145deg, rgba(0, 245, 255, 0.15), rgba(0, 245, 255, 0.05));
        }

        .category-emoji {
            font-size: 24px;
            display: block;
            margin-bottom: 8px;
        }

        /* 결과 표시 영역 */
        .result-container {
            background: linear-gradient(145deg, rgba(10, 10, 20, 0.95), rgba(5, 5, 15, 0.95));
            border-radius: 24px;
            border: 2px solid rgba(0, 245, 255, 0.15);
            padding: 40px;
            margin-bottom: 30px;
            min-height: 180px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .result-container::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: conic-gradient(from 0deg, transparent, rgba(0, 245, 255, 0.03), transparent 30%);
            animation: rotateBg 10s linear infinite;
        }

        @keyframes rotateBg {
            100% { transform: rotate(360deg); }
        }

        .result-number {
            font-family: 'Orbitron', sans-serif;
            font-size: 14px;
            font-weight: 600;
            color: var(--neon-cyan);
            letter-spacing: 4px;
            margin-bottom: 15px;
            opacity: 0.8;
            position: relative;
            z-index: 1;
        }

        .result-text {
            font-family: 'Noto Sans KR', sans-serif;
            font-size: clamp(1.3rem, 3vw, 2rem);
            font-weight: 700;
            line-height: 1.6;
            color: #ffffff;
            text-shadow: 0 0 30px rgba(255, 255, 255, 0.3);
            position: relative;
            z-index: 1;
            max-width: 800px;
        }

        .result-category {
            margin-top: 20px;
            padding: 8px 20px;
            background: linear-gradient(135deg, rgba(255, 0, 255, 0.2), rgba(0, 245, 255, 0.2));
            border-radius: 30px;
            font-size: 13px;
            font-weight: 600;
            color: #b8b8c8;
            letter-spacing: 2px;
            position: relative;
            z-index: 1;
        }

        /* 버튼 영역 */
        .button-group {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .generate-btn {
            padding: 20px 50px;
            font-family: 'Orbitron', sans-serif;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition: all 0.4s ease;
        }

        .generate-btn.primary {
            background: linear-gradient(135deg, var(--neon-cyan), var(--neon-green));
            color: var(--dark-bg);
            box-shadow: 
                0 10px 40px rgba(0, 245, 255, 0.4),
                0 0 60px rgba(0, 245, 255, 0.2);
        }

        .generate-btn.primary:hover {
            transform: translateY(-5px) scale(1.05);
            box-shadow: 
                0 20px 60px rgba(0, 245, 255, 0.5),
                0 0 80px rgba(0, 245, 255, 0.3);
        }

        .generate-btn.secondary {
            background: linear-gradient(135deg, var(--neon-pink), var(--neon-orange));
            color: #ffffff;
        }

        .generate-btn.secondary:hover {
            transform: translateY(-5px) scale(1.05);
            box-shadow: 
                0 20px 60px rgba(255, 0, 255, 0.4),
                0 0 80px rgba(255, 0, 255, 0.2);
        }

        .copy-btn {
            padding: 18px 40px;
            background: transparent;
            border: 2px solid var(--neon-cyan);
            border-radius: 50px;
            color: var(--neon-cyan);
            font-family: 'Rajdhani', sans-serif;
            font-size: 16px;
            font-weight: 600;
            letter-spacing: 2px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .copy-btn:hover {
            background: rgba(0, 245, 255, 0.1);
            transform: translateY(-3px);
        }

        /* 통계 영역 */
        .stats-bar {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-item {
            background: linear-gradient(145deg, rgba(20, 20, 40, 0.7), rgba(10, 10, 25, 0.7));
            border-radius: 16px;
            border: 1px solid rgba(0, 245, 255, 0.1);
            padding: 25px 20px;
            text-align: center;
            transition: all 0.3s ease;
        }

        .stat-item:hover {
            transform: translateY(-5px);
            border-color: rgba(0, 245, 255, 0.3);
        }

        .stat-value {
            font-family: 'Orbitron', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            background: linear-gradient(135deg, var(--neon-cyan), var(--neon-pink));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-label {
            font-size: 13px;
            font-weight: 500;
            color: #8888aa;
            margin-top: 8px;
            letter-spacing: 1px;
        }

        /* 전체 핑계 리스트 */
        .excuse-list-section {
            background: var(--card-bg);
            border-radius: 30px;
            border: 1px solid var(--glass-border);
            padding: 50px 40px;
            margin-bottom: 40px;
            backdrop-filter: blur(30px);
        }

        .section-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.8rem;
            font-weight: 700;
            text-align: center;
            margin-bottom: 40px;
            background: linear-gradient(135deg, var(--neon-cyan), var(--neon-pink));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .excuse-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 15px;
            max-height: 600px;
            overflow-y: auto;
            padding: 10px;
        }

        .excuse-grid::-webkit-scrollbar {
            width: 8px;
        }

        .excuse-grid::-webkit-scrollbar-track {
            background: rgba(20, 20, 40, 0.5);
            border-radius: 4px;
        }

        .excuse-grid::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, var(--neon-cyan), var(--neon-pink));
            border-radius: 4px;
        }

        .excuse-item {
            background: linear-gradient(145deg, rgba(20, 20, 40, 0.6), rgba(10, 10, 25, 0.6));
            border-radius: 12px;
            border: 1px solid rgba(0, 245, 255, 0.1);
            padding: 15px 20px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .excuse-item:hover {
            transform: translateX(10px);
            border-color: var(--neon-cyan);
            background: linear-gradient(145deg, rgba(0, 245, 255, 0.1), rgba(20, 20, 40, 0.8));
        }

        .excuse-num {
            font-family: 'Orbitron', sans-serif;
            font-size: 12px;
            font-weight: 700;
            color: var(--neon-cyan);
            min-width: 45px;
        }

        .excuse-text {
            font-size: 14px;
            color: #c8c8d8;
            line-height: 1.4;
        }

        /* 하단 영역 */
        .footer-section {
            background: linear-gradient(135deg, rgba(0, 245, 255, 0.05), rgba(255, 0, 255, 0.05));
            border-radius: 30px;
            border: 1px solid var(--glass-border);
            padding: 50px 40px;
            text-align: center;
            backdrop-filter: blur(20px);
        }

        .donation-box {
            background: linear-gradient(145deg, rgba(255, 215, 0, 0.1), rgba(255, 107, 53, 0.1));
            border: 2px solid rgba(255, 215, 0, 0.3);
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 40px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .donation-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--neon-yellow);
            margin-bottom: 15px;
        }

        .donation-account {
            font-family: 'Rajdhani', sans-serif;
            font-size: 1.5rem;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 10px;
            letter-spacing: 2px;
        }

        .donation-name {
            color: var(--neon-cyan);
            font-weight: 700;
        }

        .donation-desc {
            font-size: 13px;
            color: #9999aa;
            line-height: 1.8;
            margin-top: 15px;
        }

        .creator-info {
            margin-top: 30px;
            padding-top: 30px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .creator-label {
            font-size: 12px;
            color: #6666aa;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .creator-name {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.8rem;
            font-weight: 800;
            background: linear-gradient(135deg, var(--neon-cyan), var(--neon-pink));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 5px;
        }

        .company-name {
            font-family: 'Rajdhani', sans-serif;
            font-size: 1.2rem;
            font-weight: 600;
            color: #8888aa;
            letter-spacing: 4px;
        }

        /* 파티클 효과 */
        .particle {
            position: fixed;
            pointer-events: none;
            border-radius: 50%;
            animation: float 15s infinite;
            z-index: 0;
        }

        @keyframes float {
            0%, 100% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { transform: translateY(-100vh) rotate(720deg); opacity: 0; }
        }

        /* 반응형 */
        @media (max-width: 768px) {
            .container {
                padding: 15px;
            }

            .generator-section, .excuse-list-section, .footer-section {
                padding: 30px 20px;
                border-radius: 20px;
            }

            .result-container {
                padding: 30px 20px;
            }

            .category-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .button-group {
                flex-direction: column;
                align-items: center;
            }

            .generate-btn {
                width: 100%;
                max-width: 300px;
            }
        }

        /* 복사 성공 토스트 */
        .toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: linear-gradient(135deg, var(--neon-green), var(--neon-cyan));
            color: var(--dark-bg);
            padding: 15px 40px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 14px;
            letter-spacing: 1px;
            z-index: 1000;
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }

        .toast.show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }

        /* 검색 필터 */
        .search-box {
            margin-bottom: 30px;
        }

        .search-input {
            width: 100%;
            max-width: 500px;
            padding: 18px 30px;
            background: rgba(10, 10, 20, 0.8);
            border: 2px solid rgba(0, 245, 255, 0.2);
            border-radius: 50px;
            color: #ffffff;
            font-size: 16px;
            font-family: 'Noto Sans KR', sans-serif;
            outline: none;
            transition: all 0.3s ease;
        }

        .search-input:focus {
            border-color: var(--neon-cyan);
            box-shadow: 0 0 30px rgba(0, 245, 255, 0.2);
        }

        .search-input::placeholder {
            color: #666688;
        }
    </style>
</head>
<body>
    <div class="bg-animation"></div>
    <div class="grid-pattern"></div>

    <div class="container">
        <!-- 상단 SNS 링크 -->
        <div class="top-links">
            <a href="https://www.youtube.com/@%EC%BD%94%EC%9D%B8%ED%8C%8C%EB%B0%8D" target="_blank" class="sns-link">
                <div class="sns-icon" style="background: linear-gradient(135deg, #FF0000, #CC0000);">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M23.5 6.2c-.3-1-1-1.8-2-2.1C19.6 3.5 12 3.5 12 3.5s-7.6 0-9.5.6c-1 .3-1.7 1.1-2 2.1C0 8.1 0 12 0 12s0 3.9.5 5.8c.3 1 1 1.8 2 2.1 1.9.6 9.5.6 9.5.6s7.6 0 9.5-.6c1-.3 1.7-1.1 2-2.1.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.5 15.5v-7l6.4 3.5-6.4 3.5z"/></svg>
                </div>
                <span class="sns-name">코인파밍</span>
            </a>
            <a href="https://www.youtube.com/@민지네일상" target="_blank" class="sns-link">
                <div class="sns-icon" style="background: linear-gradient(135deg, #FF6B6B, #FF0000);">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M23.5 6.2c-.3-1-1-1.8-2-2.1C19.6 3.5 12 3.5 12 3.5s-7.6 0-9.5.6c-1 .3-1.7 1.1-2 2.1C0 8.1 0 12 0 12s0 3.9.5 5.8c.3 1 1 1.8 2 2.1 1.9.6 9.5.6 9.5.6s7.6 0 9.5-.6c1-.3 1.7-1.1 2-2.1.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.5 15.5v-7l6.4 3.5-6.4 3.5z"/></svg>
                </div>
                <span class="sns-name">민지네일상</span>
