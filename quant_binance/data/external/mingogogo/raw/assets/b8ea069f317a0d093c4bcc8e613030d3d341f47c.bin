    <!-- 메인 컨테이너 -->
    <div class="container">
        <!-- 타이틀 -->
        <div class="main-title">
            <h1>🎙️ TTS 방송 시스템</h1>
            <p class="subtitle">민지네 무료 배포 - 스마트 음성 안내 시스템</p>
        </div>

        <div class="main-grid">
            <!-- TTS 설정 카드 -->
            <div class="card">
                <div class="card-header">
                    <div class="card-icon">🎤</div>
                    <h2 class="card-title">TTS 설정</h2>
                </div>

                <div class="input-group">
                    <label for="ttsText">방송할 텍스트</label>
                    <textarea id="ttsText" placeholder="여기에 방송할 내용을 입력하세요...">안녕하세요. 민지네 TTS 방송 시스템 테스트입니다.</textarea>
                </div>

                <div class="input-group">
                    <label>🌍 자동 번역 (한국어 텍스트를 다른 언어로)</label>
                    <div style="display: flex; gap: 10px;">
                        <select id="translateLang" style="flex: 1;">
                            <option value="ko">한국어 (원본)</option>
                            <option value="en">영어</option>
                            <option value="ja">일본어</option>
                            <option value="zh-CN">중국어 (간체)</option>
                            <option value="zh-TW">중국어 (번체)</option>
                            <option value="es">스페인어</option>
                            <option value="fr">프랑스어</option>
                            <option value="de">독일어</option>
                            <option value="ru">러시아어</option>
                            <option value="ar">아랍어</option>
                            <option value="hi">힌디어</option>
                            <option value="vi">베트남어</option>
                            <option value="th">태국어</option>
                            <option value="it">이탈리아어</option>
                            <option value="pt">포르투갈어</option>
                        </select>
                        <button class="btn btn-primary" onclick="autoTranslate()">
                            <i class="fas fa-language"></i> 번역하기
                        </button>
                    </div>
                </div>

                <div class="input-group">
                    <label>🎭 음성 캐릭터 선택 (스크롤하여 선택)</label>
                    <div class="voice-selector" id="voiceSelector">
                        <!-- 음성 옵션들이 동적으로 추가됩니다 -->
                    </div>
                </div>

                <div class="input-group">
                    <label for="speechRate">🎚️ 속도</label>
                    <div class="slider-control">
                        <input type="range" id="speechRate" min="0.5" max="2" step="0.1" value="1">
                        <span class="slider-value" id="speechRateValue">1.0</span>
                    </div>
                </div>

                <div class="input-group">
                    <label for="speechPitch">🎵 음높이</label>
                    <div class="slider-control">
                        <input type="range" id="speechPitch" min="0.5" max="2" step="0.1" value="1">
                        <span class="slider-value" id="speechPitchValue">1.0</span>
                    </div>
                </div>

                <div class="input-group">
                    <label for="speechVolume">🔊 음량</label>
                    <div class="slider-control">
                        <input type="range" id="speechVolume" min="0" max="1" step="0.1" value="1">
                        <span class="slider-value" id="speechVolumeValue">100%</span>
                    </div>
                </div>

                <div class="input-group">
                    <label for="scheduleTime">⏰ 예약 시간 (선택사항)</label>
                    <input type="time" id="scheduleTime">
                </div>

                <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                    <button class="btn btn-primary" onclick="playTTS()">
                        <i class="fas fa-play"></i> 즉시 재생
                    </button>
                    <button class="btn btn-success" onclick="scheduleTTS()">
                        <i class="fas fa-clock"></i> 예약 추가
                    </button>
                    <button class="btn btn-warning" onclick="saveTTS()">
                        <i class="fas fa-save"></i> 음성 저장
                    </button>
                </div>
            </div>

            <!-- YouTube 배경음악 카드 -->
            <div class="card">
                <div class="card-header">
                    <div class="card-icon">🎵</div>
                    <h2 class="card-title">YouTube 배경음악</h2>
                </div>

                <div class="input-group">
                    <label for="youtubeUrl">YouTube URL 또는 비디오 ID</label>
                    <input type="text" id="youtubeUrl" placeholder="예: https://youtube.com/watch?v=... 또는 비디오ID">
                </div>

                <button class="btn btn-primary" onclick="loadYouTubeVideo()">
                    <i class="fas fa-download"></i> YouTube 로드
                </button>

                <div class="youtube-container" id="youtubePlayerContainer" style="display: none;">
                    <div id="youtubePlayer"></div>
                </div>

                <div class="input-group">
                    <label>🔊 YouTube 볼륨</label>
                    <div class="slider-control">
                        <input type="range" id="bgVolume" min="0" max="100" value="30">
                        <span class="slider-value" id="bgVolumeValue">30%</span>
                    </div>
                </div>

                <div class="input-group">
                    <label>🎚️ 더킹 레벨 (TTS 재생시 음악 볼륨)</label>
                    <div class="slider-control">
                        <input type="range" id="duckingLevel" min="0" max="100" value="10">
                        <span class="slider-value" id="duckingValue">10%</span>
                    </div>
                </div>

                <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                    <button class="btn btn-primary" onclick="playYouTube()">
                        <i class="fas fa-play"></i> 재생
                    </button>
                    <button class="btn btn-warning" onclick="pauseYouTube()">
                        <i class="fas fa-pause"></i> 일시정지
                    </button>
                    <button class="btn btn-danger" onclick="stopYouTube()">
                        <i class="fas fa-stop"></i> 정지
                    </button>
                </div>
            </div>
        </div>

        <!-- 예약 목록 카드 -->
        <div class="card">
            <div class="card-header">
                <div class="card-icon">⏰</div>
