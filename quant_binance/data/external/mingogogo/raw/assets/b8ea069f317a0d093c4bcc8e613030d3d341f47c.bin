            </div>
            <div id="scheduleList">
                <p style="color: var(--text-light); text-align: center; padding: 20px;">예약된 방송이 없습니다.</p>
            </div>
        </div>

        <!-- 저장된 음성 카드 -->
        <div class="card">
            <div class="card-header">
                <div class="card-icon">💾</div>
                <h2 class="card-title">저장된 음성</h2>
            </div>
            <div id="savedAudioList" class="saved-audio-list">
                <p style="color: var(--text-light); text-align: center; padding: 20px; grid-column: 1/-1;">저장된 음성이 없습니다.</p>
            </div>
        </div>
    </div>

    <!-- 푸터 -->
    <div class="footer">
        <p class="footer-text"><strong>도움이 되셨다면 오셔서 좋아요 부탁드립니다!</strong></p>
        <a href="https://mingogogo.tistory.com/" target="_blank" class="like-button">
            <i class="fas fa-heart"></i> 좋아요 하러 가기
        </a>
        <p class="footer-text">© 2024 Minjine's - All Rights Reserved</p>
        <p class="footer-text">민지네 무료 배포 버전</p>
    </div>

    <!-- 토스트 메시지 -->
    <div id="toast" class="toast"></div>

    <!-- YouTube IFrame API -->
    <script src="https://www.youtube.com/iframe_api"></script>

    <script>
        // 전역 변수
        let youtubePlayer = null;
        let currentYouTubeVolume = 30;
        let isPlaying = false;
        let scheduleList = [];
        let savedAudios = [];
        let selectedVoice = null;
        let availableVoices = [];

        // 음성 옵션 정의 - 실제 차별화된 무료 TTS API 음성들
        const voiceOptions = [
            // 한국어 음성 - 다양한 스타일
            { id: 'google-ko-female', name: '구글 여성', lang: 'ko', gender: 'female', description: 'Google TTS 여성 음성', api: 'google', icon: '👩', rate: 1.0, pitch: 1.0 },
            { id: 'google-ko-male', name: '구글 남성', lang: 'ko', gender: 'male', description: 'Google TTS 남성 음성', api: 'google', icon: '👨', rate: 0.9, pitch: 0.8 },
            { id: 'rv-korean-female', name: '민지 (프리미엄)', lang: 'ko', gender: 'female', description: '부드럽고 자연스러운 음성', api: 'responsive', icon: '🎙️', voiceName: 'Korean Female' },
            { id: 'browser-ko-female', name: '서연 (기본)', lang: 'ko-KR', gender: 'female', description: '브라우저 여성 음성', api: 'browser', icon: '👩‍💼', rate: 1.0, pitch: 1.2 },
            { id: 'browser-ko-male', name: '준호 (기본)', lang: 'ko-KR', gender: 'male', description: '브라우저 남성 음성', api: 'browser', icon: '👨‍💼', rate: 0.95, pitch: 0.9 },
            { id: 'google-ko-child', name: '아이 음성', lang: 'ko', gender: 'neutral', description: '귀여운 아이 목소리', api: 'google', icon: '👶', rate: 1.2, pitch: 1.5 },
            
            // 영어 음성
            { id: 'google-en-us-female', name: 'Emma (US)', lang: 'en', gender: 'female', description: 'American English female', api: 'google', icon: '🗽', rate: 1.0, pitch: 1.1 },
            { id: 'rv-us-female', name: 'Jennifer (US)', lang: 'en-US', gender: 'female', description: 'Natural US female voice', api: 'responsive', icon: '👩‍🎓', voiceName: 'US English Female' },
            { id: 'rv-uk-male', name: 'Daniel (UK)', lang: 'en-GB', gender: 'male', description: 'British male voice', api: 'responsive', icon: '🎩', voiceName: 'UK English Male' },
            { id: 'rv-uk-female', name: 'Amy (UK)', lang: 'en-GB', gender: 'female', description: 'British female voice', api: 'responsive', icon: '👸', voiceName: 'UK English Female' },
            { id: 'rv-australian', name: 'Nicole (AU)', lang: 'en-AU', gender: 'female', description: 'Australian accent', api: 'responsive', icon: '🦘', voiceName: 'Australian Female' },
            
            // 일본어 음성
            { id: 'google-ja-female', name: 'さくら', lang: 'ja', gender: 'female', description: '일본어 여성 음성', api: 'google', icon: '🌸', rate: 1.0, pitch: 1.2 },
            { id: 'rv-japanese-female', name: 'みずき', lang: 'ja', gender: 'female', description: '자연스러운 일본어', api: 'responsive', icon: '👘', voiceName: 'Japanese Female' },
            { id: 'rv-japanese-male', name: 'たける', lang: 'ja', gender: 'male', description: '일본어 남성 음성', api: 'responsive', icon: '🎌', voiceName: 'Japanese Male' },
            
            // 중국어 음성
            { id: 'google-zh-female', name: '小美', lang: 'zh-CN', gender: 'female', description: '중국어 여성', api: 'google', icon: '🏮', rate: 1.0, pitch: 1.1 },
            { id: 'rv-chinese-female', name: '晓晓', lang: 'zh-CN', gender: 'female', description: '중국어 표준 음성', api: 'responsive', icon: '🐉', voiceName: 'Chinese Female' },
            { id: 'rv-chinese-male', name: '云峰', lang: 'zh-CN', gender: 'male', description: '중국어 남성', api: 'responsive', icon: '🏛️', voiceName: 'Chinese Male' },
            { id: 'rv-taiwan', name: '美玲', lang: 'zh-TW', gender: 'female', description: '대만 중국어', api: 'responsive', icon: '🌺', voiceName: 'Chinese (Taiwan) Female' },
            
            // 기타 언어
            { id: 'google-es', name: 'Sofia', lang: 'es', gender: 'female', description: '스페인어', api: 'google', icon: '💃', rate: 1.0, pitch: 1.1 },
            { id: 'google-fr', name: 'Marie', lang: 'fr', gender: 'female', description: '프랑스어', api: 'google', icon: '🥖', rate: 1.0, pitch: 1.2 },
            { id: 'google-de', name: 'Anna', lang: 'de', gender: 'female', description: '독일어', api: 'google', icon: '🍺', rate: 1.0, pitch: 1.0 },
            { id: 'google-ru', name: 'Катя', lang: 'ru', gender: 'female', description: '러시아어', api: 'google', icon: '🪆', rate: 0.95, pitch: 1.1 },
            { id: 'google-ar', name: 'فاطمة', lang: 'ar', gender: 'female', description: '아랍어', api: 'google', icon: '🕌', rate: 1.0, pitch: 1.0 },
            { id: 'rv-hindi', name: 'प्रिया', lang: 'hi', gender: 'female', description: '힌디어', api: 'responsive', icon: '🕉️', voiceName: 'Hindi Female' },
            { id: 'rv-italian', name: 'Alice', lang: 'it', gender: 'female', description: '이탈리아어', api: 'responsive', icon: '🍕', voiceName: 'Italian Female' }
        ];

        // 초기화
        window.addEventListener('DOMContentLoaded', () => {
            initializeVoices();
            updateSliderValues();
            loadSavedData();
            setupEventListeners();
            
            // ResponsiveVoice 초기화 확인
            if (typeof responsiveVoice !== 'undefined') {
                responsiveVoice.init();
                console.log('ResponsiveVoice loaded successfully');
            }
        });

        // 음성 초기화
        function initializeVoices() {
            const voiceSelector = document.getElementById('voiceSelector');
            
            // 브라우저 음성 로드
            if ('speechSynthesis' in window) {
                speechSynthesis.getVoices();
                speechSynthesis.addEventListener('voiceschanged', () => {
                    availableVoices = speechSynthesis.getVoices();
                    renderVoiceOptions();
                });
            }
            
            renderVoiceOptions();
        }

        // 음성 옵션 렌더링
        function renderVoiceOptions() {
            const voiceSelector = document.getElementById('voiceSelector');
            voiceSelector.innerHTML = '';
            
            voiceOptions.forEach(voice => {
                const voiceCard = document.createElement('div');
                voiceCard.className = 'voice-card';
                voiceCard.dataset.voiceId = voice.id;
                voiceCard.onclick = () => selectVoice(voice);
                
                voiceCard.innerHTML = `
                    <div class="voice-avatar">${voice.icon}</div>
                    <div class="voice-info">
                        <div class="voice-name">${voice.name}</div>
                        <span class="voice-lang">${voice.lang}</span>
                        <div class="voice-description">${voice.description}</div>
                    </div>
                    <button class="btn btn-small btn-primary" onclick="previewVoice('${voice.id}', event)">
                        <i class="fas fa-volume-up"></i> 미리듣기
                    </button>
                `;
                
                voiceSelector.appendChild(voiceCard);
            });
            
            // 첫 번째 음성 선택
            if (voiceOptions.length > 0) {
                selectVoice(voiceOptions[0]);
            }
        }

        // 음성 선택
        function selectVoice(voice) {
            selectedVoice = voice;
            
            document.querySelectorAll('.voice-card').forEach(card => {
                card.classList.remove('selected');
            });
            
            const selectedCard = document.querySelector(`[data-voice-id="${voice.id}"]`);
            if (selectedCard) {
                selectedCard.classList.add('selected');
            }
            
            // 선택된 음성으로 자동 언어 번역
            if (voice.lang !== 'ko-KR') {
                translateText(voice.lang);
            }
        }

        // 음성 미리듣기
        function previewVoice(voiceId, event) {
            event.stopPropagation();
            const voice = voiceOptions.find(v => v.id === voiceId);
            const previewText = getPreviewText(voice.lang);
            
            playVoice(previewText, voice);
            showToast(`${voice.name} 음성을 미리 들어보세요!`, 'info');
        }

        // 언어별 미리듣기 텍스트
        function getPreviewText(lang) {
            const texts = {
                'ko': '안녕하세요. 민지네 TTS 시스템입니다. 이 음성이 마음에 드시나요?',
                'ko-KR': '안녕하세요. 민지네 TTS 시스템입니다. 이 음성이 마음에 드시나요?',
                'en': 'Hello. This is Minjine TTS system. Do you like this voice?',
                'en-US': 'Hello. This is Minjine TTS system. Do you like this voice?',
                'en-GB': 'Hello. This is Minjine TTS system. Do you like this voice?',
                'en-AU': "G'day! This is Minjine TTS system. Do you like this voice?",
                'ja': 'こんにちは。ミンジネTTSシステムです。この声はいかがですか？',
                'zh-CN': '你好。这是Minjine TTS系统。您喜欢这个声音吗？',
                'zh-TW': '你好。這是Minjine TTS系統。您喜歡這個聲音嗎？',
                'es': 'Hola. Este es el sistema TTS de Minjine. ¿Te gusta esta voz?',
                'fr': 'Bonjour. Ceci est le système TTS de Minjine. Aimez-vous cette voix?',
                'de': 'Hallo. Dies ist das Minjine TTS-System. Gefällt Ihnen diese Stimme?',
                'ru': 'Здравствуйте. Это система TTS Minjine. Вам нравится этот голос?',
                'ar': 'مرحبا. هذا هو نظام Minjine TTS. هل تحب هذا الصوت؟',
                'hi': 'नमस्ते। यह Minjine TTS सिस्टम है। क्या आपको यह आवाज़ पसंद है?',
                'it': 'Ciao. Questo è il sistema TTS di Minjine. Ti piace questa voce?'
            };
            return texts[lang] || texts['en'];
        }

        // 자동 번역 함수
        async function autoTranslate() {
            const text = document.getElementById('ttsText').value;
            const targetLang = document.getElementById('translateLang').value;
            
            if (!text.trim()) {
                showToast('번역할 텍스트를 입력해주세요.', 'error');
                return;
            }

            if (targetLang === 'ko') {
                showToast('한국어는 원본 언어입니다.', 'info');
                return;
            }

            try {
                showToast('번역 중입니다...', 'info');
                
                // Google Translate 무료 API 사용
                const response = await fetch(`https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=${targetLang}&dt=t&q=${encodeURIComponent(text)}`);
                const data = await response.json();
                const translatedText = data[0].map(item => item[0]).join('');
                document.getElementById('ttsText').value = translatedText;
                
                // 번역된 언어에 맞는 음성 자동 선택
                const matchingVoice = voiceOptions.find(v => {
                    const voiceLang = v.lang.split('-')[0];
                    const targetLangCode = targetLang.split('-')[0];
                    return voiceLang === targetLangCode;
                });
                
                if (matchingVoice) {
                    selectVoice(matchingVoice);
                    showToast(`번역 완료! ${matchingVoice.name} 음성이 자동 선택되었습니다.`, 'success');
                } else {
                    showToast('번역이 완료되었습니다!', 'success');
                }
            } catch (error) {
                console.error('Translation error:', error);
                showToast('번역 중 오류가 발생했습니다.', 'error');
            }
        }

        // 음성 선택 함수
        function selectVoice(voice) {
            selectedVoice = voice;
            
            document.querySelectorAll('.voice-card').forEach(card => {
                card.classList.remove('selected');
            });
            
            const selectedCard = document.querySelector(`[data-voice-id="${voice.id}"]`);
            if (selectedCard) {
                selectedCard.classList.add('selected');
                // 선택된 카드로 스크롤
                selectedCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        // 언어별 미리듣기 텍스트
        function getPreviewText(lang) {
            const texts = {
                'ko-KR': '안녕하세요. 민지네 TTS 시스템입니다.',
                'en-US': 'Hello. This is Minjine TTS system.',
                'en-GB': 'Hello. This is Minjine TTS system.',
                'ja-JP': 'こんにちは。ミンジネTTSシステムです。',
                'zh-CN': '你好。这是Minjine TTS系统。',
                'es-ES': 'Hola. Este es el sistema TTS de Minjine.',
                'fr-FR': 'Bonjour. Ceci est le système TTS de Minjine.',
                'de-DE': 'Hallo. Dies ist das Minjine TTS-System.'
            };
            return texts[lang] || texts['en-US'];
        }

        // 텍스트 번역 (선택된 음성 언어로)
        async function translateText(targetLang) {
            const text = document.getElementById('ttsText').value;
            if (!text.trim()) return;
            
            const langCode = targetLang.split('-')[0];
            
            try {
                // Google Translate 무료 API 사용
                const response = await fetch(`https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=${langCode}&dt=t&q=${encodeURIComponent(text)}`);
                const data = await response.json();
                const translatedText = data[0].map(item => item[0]).join('');
                document.getElementById('ttsText').value = translatedText;
                showToast('텍스트가 선택된 언어로 번역되었습니다.', 'success');
            } catch (error) {
                console.error('Translation error:', error);
                showToast('번역 중 오류가 발생했습니다.', 'error');
            }
        }

        // 음성 재생 - 실제 다양한 API 사용
        function playVoice(text, voice) {
            // 기존 음성 중지
            if (window.speechSynthesis) {
                window.speechSynthesis.cancel();
            }
            if (typeof responsiveVoice !== 'undefined') {
                responsiveVoice.cancel();
            }
            
            const rate = parseFloat(document.getElementById('speechRate').value);
            const pitch = parseFloat(document.getElementById('speechPitch').value);
            const volume = parseFloat(document.getElementById('speechVolume').value);
            
            // YouTube 더킹 시작
            if (youtubePlayer && isPlaying) {
                startYouTubeDucking();
            }
            
            // API별 처리
            if (voice.api === 'google') {
                // Google TTS API 사용
                playGoogleTTS(text, voice, rate, pitch, volume);
            } else if (voice.api === 'responsive' && typeof responsiveVoice !== 'undefined') {
                // ResponsiveVoice 사용
                const voiceSettings = {
                    rate: rate * (voice.rate || 1.0),
                    pitch: pitch * (voice.pitch || 1.0),
                    volume: volume,
                    onend: () => {
                        if (youtubePlayer && isPlaying) {
                            stopYouTubeDucking();
                        }
                    }
                };
                
                responsiveVoice.speak(text, voice.voiceName || 'Korean Female', voiceSettings);
            } else {
                // Web Speech API 사용 (브라우저 내장)
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = voice.lang;
                utterance.rate = rate * (voice.rate || 1.0);
                utterance.pitch = pitch * (voice.pitch || 1.0);
                utterance.volume = volume;
                
                // 특정 브라우저 음성 선택
                if (availableVoices.length > 0) {
                    let matchedVoice = null;
                    
                    // 성별에 따른 음성 매칭
                    if (voice.gender === 'female') {
                        matchedVoice = availableVoices.find(v => 
                            v.lang === voice.lang && v.name.toLowerCase().includes('female')
                        ) || availableVoices.find(v => 
                            v.lang === voice.lang && !v.name.toLowerCase().includes('male')
                        );
                    } else if (voice.gender === 'male') {
                        matchedVoice = availableVoices.find(v => 
                            v.lang === voice.lang && v.name.toLowerCase().includes('male')
                        );
                    }
                    
                    // 언어만 매칭
                    if (!matchedVoice) {
                        matchedVoice = availableVoices.find(v => v.lang === voice.lang) ||
                                      availableVoices.find(v => v.lang.startsWith(voice.lang.split('-')[0]));
                    }
                    
                    if (matchedVoice) {
                        utterance.voice = matchedVoice;
                    }
                }
                
                utterance.onend = () => {
                    if (youtubePlayer && isPlaying) {
                        stopYouTubeDucking();
                    }
                };
                
                speechSynthesis.speak(utterance);
            }
        }
        
        // Google TTS 재생
        function playGoogleTTS(text, voice, rate, pitch, volume) {
            // Google TTS URL 생성
            const audio = new Audio();
            const baseUrl = 'https://translate.google.com/translate_tts';
            const params = new URLSearchParams({
                ie: 'UTF-8',
                q: text,
                tl: voice.lang,
                client: 'tw-ob',
                ttsspeed: rate * (voice.rate || 1.0)
            });
            
            audio.src = `${baseUrl}?${params.toString()}`;
            audio.volume = volume;
            audio.playbackRate = rate * (voice.rate || 1.0);
            
            // 피치 조정 (Web Audio API 사용)
            if (pitch !== 1.0 && window.AudioContext) {
                const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                const source = audioContext.createMediaElementSource(audio);
                const pitchShift = audioContext.createBiquadFilter();
                pitchShift.type = 'allpass';
                pitchShift.frequency.value = 1000 * pitch * (voice.pitch || 1.0);
                source.connect(pitchShift);
                pitchShift.connect(audioContext.destination);
            }
            
            audio.onended = () => {
                if (youtubePlayer && isPlaying) {
                    stopYouTubeDucking();
                }
            };
            
            audio.play().catch(error => {
                console.error('Google TTS error:', error);
                // 폴백으로 브라우저 TTS 사용
                showToast('Google TTS 오류, 브라우저 음성으로 재생합니다.', 'warning');
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = voice.lang;
                utterance.rate = rate;
                utterance.pitch = pitch;
                utterance.volume = volume;
                speechSynthesis.speak(utterance);
            });
        }

        // TTS 재생
        function playTTS() {
            const text = document.getElementById('ttsText').value;
            
            if (!text.trim()) {
                showToast('텍스트를 입력해주세요.', 'error');
                return;
            }
            
            if (!selectedVoice) {
                showToast('음성을 선택해주세요.', 'error');
                return;
            }
            
            playVoice(text, selectedVoice);
            showToast('음성 재생을 시작합니다.', 'success');
        }

        // TTS 예약
        function scheduleTTS() {
            const text = document.getElementById('ttsText').value;
            const scheduleTime = document.getElementById('scheduleTime').value;
            
            if (!text.trim()) {
                showToast('텍스트를 입력해주세요.', 'error');
                return;
            }
            
            if (!scheduleTime) {
                showToast('예약 시간을 선택해주세요.', 'error');
                return;
            }
            
            if (!selectedVoice) {
                showToast('음성을 선택해주세요.', 'error');
                return;
            }
            
            const now = new Date();
            const scheduledDate = new Date();
            const [hours, minutes] = scheduleTime.split(':');
            scheduledDate.setHours(hours);
            scheduledDate.setMinutes(minutes);
            scheduledDate.setSeconds(0);
            
            if (scheduledDate <= now) {
                scheduledDate.setDate(scheduledDate.getDate() + 1);
            }
            
            const delay = scheduledDate - now;
            
            const scheduleItem = {
                id: Date.now(),
                text: text,
                time: scheduleTime,
                date: scheduledDate,
                voice: selectedVoice,
                status: 'waiting',
                settings: {
                    rate: document.getElementById('speechRate').value,
                    pitch: document.getElementById('speechPitch').value,
                    volume: document.getElementById('speechVolume').value
                },
                timeout: setTimeout(() => {
                    updateScheduleStatus(scheduleItem.id, 'active');
                    playVoice(text, selectedVoice);
                    setTimeout(() => updateScheduleStatus(scheduleItem.id, 'completed'), 3000);
                }, delay)
            };
            
            scheduleList.push(scheduleItem);
            updateScheduleDisplay();
            saveData();
            
            showToast(`${scheduleTime}에 방송이 예약되었습니다.`, 'success');
        }

        // TTS 저장
        function saveTTS() {
            const text = document.getElementById('ttsText').value;
            
            if (!text.trim()) {
                showToast('텍스트를 입력해주세요.', 'error');
                return;
            }
            
            if (!selectedVoice) {
                showToast('음성을 선택해주세요.', 'error');
                return;
            }
            
            const savedItem = {
                id: Date.now(),
                text: text,
                voice: selectedVoice,
                settings: {
                    rate: document.getElementById('speechRate').value,
                    pitch: document.getElementById('speechPitch').value,
                    volume: document.getElementById('speechVolume').value
                },
                date: new Date().toLocaleString('ko-KR')
            };
            
            savedAudios.push(savedItem);
            updateSavedAudioDisplay();
            saveData();
            
            showToast('음성이 저장되었습니다.', 'success');
        }

        // 저장된 음성 재생
        function playSavedAudio(id) {
            const item = savedAudios.find(a => a.id === id);
            if (item) {
                // 설정 복원
                document.getElementById('speechRate').value = item.settings.rate;
                document.getElementById('speechPitch').value = item.settings.pitch;
                document.getElementById('speechVolume').value = item.settings.volume;
                updateSliderValues();
                
                playVoice(item.text, item.voice);
                showToast('저장된 음성을 재생합니다.', 'success');
            }
        }

        // 저장된 음성 예약
        function scheduleSavedAudio(id) {
            const item = savedAudios.find(a => a.id === id);
            if (!item) return;
            
            const timeInput = document.getElementById(`saved-time-${id}`);
            const scheduleTime = timeInput.value;
            
            if (!scheduleTime) {
                showToast('예약 시간을 선택해주세요.', 'error');
                return;
            }
            
            const now = new Date();
            const scheduledDate = new Date();
            const [hours, minutes] = scheduleTime.split(':');
            scheduledDate.setHours(hours);
            scheduledDate.setMinutes(minutes);
            scheduledDate.setSeconds(0);
            
            if (scheduledDate <= now) {
                scheduledDate.setDate(scheduledDate.getDate() + 1);
            }
            
            const delay = scheduledDate - now;
            
            const scheduleItem = {
                id: Date.now(),
                text: item.text,
                time: scheduleTime,
                date: scheduledDate,
                voice: item.voice,
                status: 'waiting',
                settings: item.settings,
                timeout: setTimeout(() => {
                    updateScheduleStatus(scheduleItem.id, 'active');
                    playVoice(item.text, item.voice);
                    setTimeout(() => updateScheduleStatus(scheduleItem.id, 'completed'), 3000);
                }, delay)
            };
            
            scheduleList.push(scheduleItem);
            updateScheduleDisplay();
            saveData();
            
            showToast(`${scheduleTime}에 저장된 음성이 예약되었습니다.`, 'success');
        }

        // 저장된 음성 삭제
        function removeSavedAudio(id) {
            const index = savedAudios.findIndex(a => a.id === id);
            if (index !== -1) {
                savedAudios.splice(index, 1);
                updateSavedAudioDisplay();
                saveData();
                showToast('저장된 음성이 삭제되었습니다.', 'info');
            }
        }

        // 예약 상태 업데이트
        function updateScheduleStatus(id, status) {
            const item = scheduleList.find(s => s.id === id);
            if (item) {
                item.status = status;
                updateScheduleDisplay();
                saveData();
            }
        }

        // 예약 목록 표시
        function updateScheduleDisplay() {
            const listContainer = document.getElementById('scheduleList');
            
            if (scheduleList.length === 0) {
                listContainer.innerHTML = '<p style="color: var(--text-light); text-align: center; padding: 20px;">예약된 방송이 없습니다.</p>';
                return;
            }
            
            listContainer.innerHTML = scheduleList.map(item => {
                let statusClass = 'status-waiting';
                let statusText = '대기중';
                
                if (item.status === 'active') {
                    statusClass = 'status-active';
                    statusText = '방송중';
                } else if (item.status === 'completed') {
                    statusClass = 'status-completed';
                    statusText = '완료';
                }
                
                return `
                    <div class="schedule-item">
                        <div class="schedule-header">
                            <div class="schedule-time">
                                <span class="status-indicator ${statusClass}"></span>
                                ${item.time}
                            </div>
                            <div>
                                <span style="color: var(--text-light); font-size: 14px; margin-right: 10px;">${statusText}</span>
                                <button class="btn btn-small btn-danger" onclick="removeSchedule(${item.id})">
                                    <i class="fas fa-trash"></i> 삭제
                                </button>
                            </div>
                        </div>
                        <div style="color: var(--text-dark); margin-top: 10px;">
                            <strong>${item.voice.name}</strong> - ${item.text.substring(0, 100)}${item.text.length > 100 ? '...' : ''}
                        </div>
                    </div>
                `;
            }).join('');
        }

        // 예약 삭제
        function removeSchedule(id) {
            const index = scheduleList.findIndex(s => s.id === id);
            if (index !== -1) {
                clearTimeout(scheduleList[index].timeout);
                scheduleList.splice(index, 1);
                updateScheduleDisplay();
                saveData();
                showToast('예약이 삭제되었습니다.', 'info');
            }
        }

        // 저장된 음성 목록 표시
        function updateSavedAudioDisplay() {
            const listContainer = document.getElementById('savedAudioList');
            
            if (savedAudios.length === 0) {
                listContainer.innerHTML = '<p style="color: var(--text-light); text-align: center; padding: 20px; grid-column: 1/-1;">저장된 음성이 없습니다.</p>';
                return;
            }
            
            listContainer.innerHTML = savedAudios.map(item => `
                <div class="saved-audio-item">
                    <div class="saved-audio-header">
                        <div class="saved-audio-icon">
                            ${item.voice.icon}
                        </div>
                        <div class="saved-audio-info">
                            <div class="saved-audio-title">${item.text.substring(0, 50)}${item.text.length > 50 ? '...' : ''}</div>
                            <div class="saved-audio-date">${item.date} | ${item.voice.name}</div>
                        </div>
                    </div>
                    <div class="schedule-input-group">
                        <label>예약 시간:</label>
                        <input type="time" id="saved-time-${item.id}">
                        <button class="btn btn-small btn-success" onclick="scheduleSavedAudio(${item.id})">
                            <i class="fas fa-clock"></i> 예약
                        </button>
                    </div>
                    <div class="saved-audio-controls">
                        <button class="btn btn-small btn-primary" onclick="playSavedAudio(${item.id})">
                            <i class="fas fa-play"></i> 재생
                        </button>
                        <button class="btn btn-small btn-danger" onclick="removeSavedAudio(${item.id})">
                            <i class="fas fa-trash"></i> 삭제
                        </button>
                    </div>
                </div>
            `).join('');
        }

        // YouTube 관련 함수들
        function onYouTubeIframeAPIReady() {
            // API 준비 완료
        }

        function loadYouTubeVideo() {
            const url = document.getElementById('youtubeUrl').value;
            if (!url) {
                showToast('YouTube URL을 입력해주세요.', 'error');
                return;
            }

            let videoId = '';
            
            if (url.includes('youtube.com')) {
                const urlParams = new URLSearchParams(new URL(url).search);
                videoId = urlParams.get('v');
            } else if (url.includes('youtu.be')) {
                videoId = url.split('/').pop();
            } else {
                videoId = url;
            }

            if (!videoId) {
                showToast('올바른 YouTube URL을 입력해주세요.', 'error');
                return;
            }

            document.getElementById('youtubePlayerContainer').style.display = 'block';

            if (youtubePlayer) {
                youtubePlayer.loadVideoById(videoId);
            } else {
                youtubePlayer = new YT.Player('youtubePlayer', {
                    height: '360',
                    width: '640',
                    videoId: videoId,
                    playerVars: {
                        'playsinline': 1,
                        'controls': 1,
                        'modestbranding': 1
                    },
                    events: {
                        'onReady': onPlayerReady,
                        'onStateChange': onPlayerStateChange
                    }
                });
            }
        }

        function onPlayerReady(event) {
            youtubePlayer.setVolume(currentYouTubeVolume);
            showToast('YouTube 비디오가 로드되었습니다.', 'success');
        }

        function onPlayerStateChange(event) {
            isPlaying = (event.data == YT.PlayerState.PLAYING);
        }

        function playYouTube() {
            if (youtubePlayer) {
                youtubePlayer.playVideo();
            } else {
                showToast('먼저 YouTube 비디오를 로드해주세요.', 'error');
            }
        }

        function pauseYouTube() {
            if (youtubePlayer) {
                youtubePlayer.pauseVideo();
            }
        }

        function stopYouTube() {
            if (youtubePlayer) {
                youtubePlayer.stopVideo();
            }
        }

        function startYouTubeDucking() {
            if (youtubePlayer) {
                const duckingLevel = document.getElementById('duckingLevel').value;
                youtubePlayer.setVolume(duckingLevel);
            }
        }

        function stopYouTubeDucking() {
            if (youtubePlayer) {
                youtubePlayer.setVolume(currentYouTubeVolume);
            }
        }

        // 슬라이더 값 업데이트
        function updateSliderValues() {
            document.getElementById('speechRate').addEventListener('input', (e) => {
                document.getElementById('speechRateValue').textContent = e.target.value;
            });
            
            document.getElementById('speechPitch').addEventListener('input', (e) => {
                document.getElementById('speechPitchValue').textContent = e.target.value;
            });
            
            document.getElementById('speechVolume').addEventListener('input', (e) => {
                document.getElementById('speechVolumeValue').textContent = Math.round(e.target.value * 100) + '%';
            });
            
            document.getElementById('bgVolume').addEventListener('input', (e) => {
                document.getElementById('bgVolumeValue').textContent = e.target.value + '%';
                currentYouTubeVolume = parseInt(e.target.value);
                if (youtubePlayer) {
                    youtubePlayer.setVolume(currentYouTubeVolume);
                }
            });
            
            document.getElementById('duckingLevel').addEventListener('input', (e) => {
                document.getElementById('duckingValue').textContent = e.target.value + '%';
            });
        }

        // 이벤트 리스너 설정
        function setupEventListeners() {
            // 초기 값 설정
            document.getElementById('speechRateValue').textContent = document.getElementById('speechRate').value;
            document.getElementById('speechPitchValue').textContent = document.getElementById('speechPitch').value;
            document.getElementById('speechVolumeValue').textContent = Math.round(document.getElementById('speechVolume').value * 100) + '%';
            document.getElementById('bgVolumeValue').textContent = document.getElementById('bgVolume').value + '%';
            document.getElementById('duckingValue').textContent = document.getElementById('duckingLevel').value + '%';
        }

        // 토스트 메시지
        function showToast(message, type = 'info') {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.className = `toast show ${type}`;
            
            setTimeout(() => {
                toast.className = 'toast';
            }, 3000);
        }

        // 데이터 저장 (LocalStorage)
        function saveData() {
            try {
                const scheduleData = scheduleList.map(item => ({
                    id: item.id,
                    text: item.text,
                    time: item.time,
                    date: item.date,
                    voice: item.voice,
                    status: item.status,
                    settings: item.settings
                }));
                
                localStorage.setItem('minjineTTSSchedules', JSON.stringify(scheduleData));
                localStorage.setItem('minjineTTSSavedAudios', JSON.stringify(savedAudios));
            } catch (error) {
                console.error('데이터 저장 실패:', error);
            }
        }

        // 데이터 불러오기
        function loadSavedData() {
            try {
                const scheduleData = localStorage.getItem('minjineTTSSchedules');
                if (scheduleData) {
                    const parsedData = JSON.parse(scheduleData);
                    parsedData.forEach(item => {
                        const scheduledDate = new Date(item.date);
                        if (scheduledDate > new Date() && item.status !== 'completed') {
                            const delay = scheduledDate - new Date();
                            item.timeout = setTimeout(() => {
                                updateScheduleStatus(item.id, 'active');
                                playVoice(item.text, item.voice);
                                setTimeout(() => updateScheduleStatus(item.id, 'completed'), 3000);
                            }, delay);
                            scheduleList.push(item);
                        }
                    });
                    updateScheduleDisplay();
                }
                
                const audioData = localStorage.getItem('minjineTTSSavedAudios');
                if (audioData) {
                    savedAudios = JSON.parse(audioData);
                    updateSavedAudioDisplay();
                }
            } catch (error) {
                console.error('데이터 불러오기 실패:', error);
            }
        }

        // 페이지 언로드 시 정리
        window.addEventListener('beforeunload', () => {
            scheduleList.forEach(item => {
                if (item.timeout) {
                    clearTimeout(item.timeout);
                }
            });
            
            if ('speechSynthesis' in window) {
                speechSynthesis.cancel();
            }
            
            if (typeof responsiveVoice !== 'undefined') {
                responsiveVoice.cancel();
            }
        });
    </script>
</body>
</html>