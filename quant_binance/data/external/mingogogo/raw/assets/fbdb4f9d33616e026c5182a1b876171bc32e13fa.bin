<script>
(function(){
var _0xExp=new Date('2026-01-31T23:59:59');
if(new Date()>_0xExp){document.body.innerHTML='<div class="expired-overlay"><h1>사용 기간 만료</h1><p>프로그램 사용 기간이 종료되었습니다.</p><a href="https://open.kakao.com/me/paming" target="_blank">갱신 문의하기</a></div>';return;}
var FRAME={'1min':{api:'minutes/1',unit:'minute'},'3min':{api:'minutes/3',unit:'minute'},'5min':{api:'minutes/5',unit:'minute'},'15min':{api:'minutes/15',unit:'minute'},'30min':{api:'minutes/30',unit:'minute'},'1hour':{api:'minutes/60',unit:'hour'},'4hour':{api:'minutes/240',unit:'hour'},'1day':{api:'days',unit:'day'}};
var COUNT=100,SMA_N=12,API_BASE='https://api.upbit.com/v1';
var el={now:document.getElementById('now'),api:document.getElementById('api'),alert:document.getElementById('alert'),controls:document.getElementById('controls'),brief:document.getElementById('brief'),chart:document.getElementById('chart'),msg:document.getElementById('msg'),modal:document.getElementById('modal'),body:document.getElementById('body'),close:document.getElementById('close'),buy:document.getElementById('buy-sound'),sell:document.getElementById('sell-sound'),manual:document.getElementById('manual'),manualModal:document.getElementById('manualModal'),manualClose:document.getElementById('manualClose')};
var active='1hour',apiCount=0,chart,topAlt=[],alertOn=false;
var bases={btc:0,eth:0,alt:0};
var alertSide={'KRW-BTC':null,'KRW-ETH':null,'ALT':null};
var fullUpdateTimer=null,streamTimer=null;
var volumeData=[];
var cachedMarkets=null,cacheTime=0;
var blinkState=true;
function tickClock(){el.now.textContent=new Date().toLocaleString('ko-KR');}
setInterval(tickClock,1000);tickClock();
async function fetchJson(url){apiCount++;el.api.textContent=apiCount;var res=await fetch(url,{cache:'no-cache',headers:{'Accept':'application/json'}});if(!res.ok)throw new Error('API '+res.status);return res.json();}
function sma(series,n){n=n||SMA_N;if(!series||series.length<n)return[];var out=[];for(var i=n-1;i<series.length;i++){var s=0;for(var j=0;j<n;j++)s+=series[i-j].y;out.push({x:series[i].x,y:s/n});}return out;}
async function getMarkets(){var now=Date.now();if(cachedMarkets&&(now-cacheTime)<300000)return cachedMarkets;cachedMarkets=await fetchJson(API_BASE+'/market/all?isDetails=true');cacheTime=now;return cachedMarkets;}
function initChart(){
var ctx=el.chart.getContext('2d');
var btcG=ctx.createLinearGradient(0,0,0,450);btcG.addColorStop(0,'rgba(247,147,26,0.25)');btcG.addColorStop(0.5,'rgba(247,147,26,0.08)');btcG.addColorStop(1,'rgba(247,147,26,0)');
var ethG=ctx.createLinearGradient(0,0,0,450);ethG.addColorStop(0,'rgba(98,126,234,0.25)');ethG.addColorStop(0.5,'rgba(98,126,234,0.08)');ethG.addColorStop(1,'rgba(98,126,234,0)');
var altG=ctx.createLinearGradient(0,0,0,450);altG.addColorStop(0,'rgba(100,255,218,0.25)');altG.addColorStop(0.5,'rgba(100,255,218,0.08)');altG.addColorStop(1,'rgba(100,255,218,0)');
var volPlugin={id:'volBg',beforeDraw:function(c){if(!volumeData||volumeData.length===0)return;var ctx=c.ctx,area=c.chartArea,xS=c.scales.x;ctx.save();var vols=volumeData.map(function(v){return v.vol;}),max=Math.max.apply(null,vols),min=Math.min.apply(null,vols);volumeData.forEach(function(item,i){var x=xS.getPixelForValue(item.x);var bw=i<volumeData.length-1?xS.getPixelForValue(volumeData[i+1].x)-x:(area.right-area.left)/volumeData.length;var ratio=max===min?0.5:(item.vol-min)/(max-min);var r,g,b,a;if(ratio>0.65){var int=(ratio-0.65)/0.35;r=255;g=Math.floor(80*(1-int));b=g;a=0.03+(int*0.07);}else if(ratio<0.35){var int=(0.35-ratio)/0.35;r=Math.floor(50*(1-int));g=Math.floor(120*(1-int));b=255;a=0.02+(int*0.05);}else{a=0;}if(a>0){ctx.fillStyle='rgba('+r+','+g+','+b+','+a+')';ctx.fillRect(x,area.top,bw,area.bottom-area.top);}});ctx.restore();}};
var glowPlugin={id:'glow',beforeDatasetsDraw:function(c){var ctx=c.ctx;ctx.save();c.data.datasets.forEach(function(ds,i){if(i<3&&ds.data.length>0){var meta=c.getDatasetMeta(i);if(!meta.hidden){ctx.shadowColor=ds.borderColor;ctx.shadowBlur=15;}}});},afterDatasetsDraw:function(c){c.ctx.restore();}};
var midnightPlugin={id:'midnight',afterDraw:function(c){var ctx=c.ctx,area=c.chartArea,xS=c.scales.x;if(!volumeData||volumeData.length===0)return;ctx.save();ctx.font='9px Orbitron';ctx.fillStyle='rgba(255,255,255,0.3)';ctx.textAlign='center';var drawn={};volumeData.forEach(function(item){var d=new Date(item.x);if(d.getHours()===0&&d.getMinutes()<30){var ds=(d.getMonth()+1)+'/'+d.getDate();if(!drawn[ds]){drawn[ds]=true;var x=xS.getPixelForValue(item.x);ctx.beginPath();ctx.strokeStyle='rgba(255,255,255,0.15)';ctx.setLineDash([3,3]);ctx.moveTo(x,area.top);ctx.lineTo(x,area.bottom);ctx.stroke();ctx.setLineDash([]);ctx.fillText(ds,x,area.bottom+12);}}});ctx.restore();}};
var livePointPlugin={id:'livePoint',afterDatasetsDraw:function(c){var datasets=c.data.datasets;var colors=['#f7931a','#627eea','#64ffda'];for(var i=0;i<3;i++){var ds=datasets[i];if(ds.data.length>0){var meta=c.getDatasetMeta(i);if(!meta.hidden){var last=meta.data[meta.data.length-1];if(last){var ctx=c.ctx;ctx.save();ctx.beginPath();ctx.arc(last.x,last.y,blinkState?6:4,0,Math.PI*2);ctx.fillStyle=colors[i];ctx.globalAlpha=blinkState?1:0.5;ctx.fill();ctx.globalAlpha=1;if(blinkState){ctx.beginPath();ctx.arc(last.x,last.y,10,0,Math.PI*2);ctx.strokeStyle=colors[i];ctx.globalAlpha=0.3;ctx.lineWidth=2;ctx.stroke();}ctx.restore();}}}}blinkState=!blinkState;}};
var isMobile=window.innerWidth<=768;
chart=new Chart(ctx,{type:'line',plugins:[volPlugin,glowPlugin,midnightPlugin,livePointPlugin],data:{datasets:[{label:'BTC',borderColor:'#f7931a',backgroundColor:btcG,tension:.35,borderWidth:isMobile?2:3,pointRadius:0,pointHoverRadius:0,fill:true,order:3},{label:'ETH',borderColor:'#627eea',backgroundColor:ethG,tension:.35,borderWidth:isMobile?2:3,pointRadius:0,pointHoverRadius:0,fill:true,order:2},{label:'알트 평균',borderColor:'#64ffda',backgroundColor:altG,tension:.35,borderWidth:isMobile?2:3,pointRadius:0,pointHoverRadius:0,fill:true,order:1},{label:'BTC SMA',borderColor:'rgba(247,147,26,0.4)',borderDash:[8,4],tension:.25,borderWidth:1.5,pointRadius:0,fill:false,order:6},{label:'ETH SMA',borderColor:'rgba(98,126,234,0.4)',borderDash:[8,4],tension:.25,borderWidth:1.5,pointRadius:0,fill:false,order:5},{label:'알트 SMA',borderColor:'rgba(100,255,218,0.4)',borderDash:[8,4],tension:.25,borderWidth:1.5,pointRadius:0,fill:false,order:4}]},options:{responsive:true,maintainAspectRatio:false,animation:false,events:[],interaction:{mode:'nearest',intersect:false,axis:'x'},plugins:{legend:{position:'top',align:isMobile?'center':'end',labels:{color:'rgba(255,255,255,.85)',font:{weight:'600',size:isMobile?10:12,family:'Orbitron'},padding:isMobile?10:16,usePointStyle:true,pointStyle:'circle',boxWidth:isMobile?8:12,filter:function(l){return!l.text.includes('SMA');}}},tooltip:{enabled:false},annotation:{annotations:{top:{type:'line',borderColor:'rgba(255,82,82,.6)',borderWidth:2,borderDash:[8,6],label:{enabled:true,content:'MAX',backgroundColor:'rgba(255,82,82,.85)',color:'#fff',font:{size:isMobile?8:10,weight:'700',family:'Orbitron'},padding:{x:6,y:3},cornerRadius:6}},bot:{type:'line',borderColor:'rgba(68,138,255,.6)',borderWidth:2,borderDash:[8,6],label:{enabled:true,content:'MIN',backgroundColor:'rgba(68,138,255,.85)',color:'#fff',font:{size:isMobile?8:10,weight:'700',family:'Orbitron'},padding:{x:6,y:3},cornerRadius:6}},zero:{type:'line',yMin:0,yMax:0,borderColor:'rgba(255,255,255,0.15)',borderWidth:1,borderDash:[4,4]}}}},scales:{x:{type:'time',time:{unit:FRAME[active].unit,tooltipFormat:'yyyy-MM-dd HH:mm',displayFormats:{minute:'HH:mm',hour:'HH:mm',day:'MM/dd'}},grid:{color:'rgba(255,255,255,.04)',drawBorder:false},ticks:{color:'rgba(255,255,255,.5)',font:{size:isMobile?9:11,family:'Exo 2'},maxRotation:0,padding:isMobile?4:8,maxTicksLimit:isMobile?6:10},border:{display:false},afterFit:function(scale){var range=scale.max-scale.min;scale.max=scale.max+(range*0.1);}},y:{grid:{color:'rgba(255,255,255,.04)',drawBorder:false},ticks:{color:'rgba(255,255,255,.6)',font:{size:isMobile?9:11,weight:'600',family:'Exo 2'},callback:function(v){return(v>=0?'+':'')+v.toFixed(1)+'%';},padding:isMobile?4:8},border:{display:false}}},layout:{padding:{left:isMobile?5:10,right:isMobile?15:30,top:isMobile?5:10,bottom:isMobile?20:25}}}});
}
async function fullUpdate(){
el.msg.textContent='데이터 갱신 중...';
try{
var iv=FRAME[active].api;
chart.options.scales.x.time.unit=FRAME[active].unit;
var marketAll=await getMarkets();
var krw=marketAll.filter(function(m){return m.market.startsWith('KRW-');});
var mkts=krw.slice(0,80).map(function(m){return m.market;});
var tickers=await fetchJson(API_BASE+'/ticker?markets='+mkts.join(','));
topAlt=tickers.filter(function(t){return!['KRW-BTC','KRW-ETH'].includes(t.market);}).sort(function(a,b){return b.acc_trade_price_24h-a.acc_trade_price_24h;}).slice(0,5);
var candleUrls=[API_BASE+'/candles/'+iv+'?market=KRW-BTC&count='+COUNT,API_BASE+'/candles/'+iv+'?market=KRW-ETH&count='+COUNT];
topAlt.forEach(function(a){candleUrls.push(API_BASE+'/candles/'+iv+'?market='+a.market+'&count='+COUNT);});
var allCandles=await Promise.all(candleUrls.map(function(url){return fetchJson(url);}));
var btc=allCandles[0],eth=allCandles[1];
if(!btc||!eth||btc.length<10)throw new Error('캔들 로딩 실패');
var btcR=btc.slice().reverse();bases.btc=btcR[0].trade_price;
var ethR=eth.slice().reverse();bases.eth=ethR[0].trade_price;
var fmt=function(cs,base){return cs.map(function(c){return{x:new Date(c.candle_date_time_kst).getTime(),y:((c.trade_price/base)-1)*100};});};
volumeData=btcR.map(function(c){return{x:new Date(c.candle_date_time_kst).getTime(),vol:c.candle_acc_trade_price};});
chart.data.datasets[0].data=fmt(btcR,bases.btc);
chart.data.datasets[1].data=fmt(ethR,bases.eth);
var altCandles=allCandles.slice(2).filter(function(a){return Array.isArray(a)&&a.length===btc.length;});
if(altCandles.length){
var avg=[];
for(var i=0;i<btc.length;i++){
var sum=0;
for(var j=0;j<altCandles.length;j++){sum+=altCandles[j].slice().reverse()[i].trade_price;}
avg.push(sum/altCandles.length);
}
bases.alt=avg[0];
chart.data.datasets[2].data=avg.map(function(v,i){return{x:new Date(btcR[i].candle_date_time_kst).getTime(),y:((v/bases.alt)-1)*100};});
}else{chart.data.datasets[2].data=[];}
chart.data.datasets[3].data=sma(chart.data.datasets[0].data);
chart.data.datasets[4].data=sma(chart.data.datasets[1].data);
chart.data.datasets[5].data=sma(chart.data.datasets[2].data);
var last=function(arr){return arr.length?arr[arr.length-1].y:null;};
alertSide['KRW-BTC']=last(chart.data.datasets[0].data)>last(chart.data.datasets[3].data)?'above':'below';
alertSide['KRW-ETH']=last(chart.data.datasets[1].data)>last(chart.data.datasets[4].data)?'above':'below';
alertSide['ALT']=last(chart.data.datasets[2].data)>last(chart.data.datasets[5].data)?'above':'below';
autoY();chart.update('none');el.msg.textContent='정상';
}catch(e){el.msg.textContent='오류: '+e.message;}
}
async function streamUpdate(){
try{
var mkts=['KRW-BTC','KRW-ETH'].concat(topAlt.map(function(a){return a.market;}));
var t=await fetchJson(API_BASE+'/ticker?markets='+mkts.join(','));
if(!t||!t.length)return;
var find=function(m){var f=t.find(function(x){return x.market===m;});return f?f.trade_price:null;};
var now=Date.now();
var updateDs=function(market,base,di,si){
var price=find(market);
if(!price||!base)return;
var y=((price/base)-1)*100;
var ds=chart.data.datasets[di].data;
if(ds.length>0){ds[ds.length-1].y=y;}
chart.data.datasets[si].data=sma(ds);
if(alertOn){
var smaDs=chart.data.datasets[si].data;
if(smaDs.length>0){
var lastS=smaDs[smaDs.length-1].y;
var prev=alertSide[market];
var cur=y>lastS?'above':'below';
if(prev==='below'&&cur==='above')el.buy.play();
if(prev==='above'&&cur==='below')el.sell.play();
alertSide[market]=cur;
}
}
};
updateDs('KRW-BTC',bases.btc,0,3);
updateDs('KRW-ETH',bases.eth,1,4);
if(topAlt.length&&bases.alt){
var vals=topAlt.map(function(a){return find(a.market);}).filter(Boolean);
if(vals.length){
var avg=vals.reduce(function(a,b){return a+b;},0)/vals.length;
var ds=chart.data.datasets[2].data;
var y=((avg/bases.alt)-1)*100;
if(ds.length>0){ds[ds.length-1].y=y;}
chart.data.datasets[5].data=sma(ds);
if(alertOn){
var smaDs=chart.data.datasets[5].data;
if(smaDs.length>0){
var lastS=smaDs[smaDs.length-1].y;
var prev=alertSide['ALT'];
var cur=y>lastS?'above':'below';
if(prev==='below'&&cur==='above')el.buy.play();
if(prev==='above'&&cur==='below')el.sell.play();
alertSide['ALT']=cur;
}
}
}
}
autoY();chart.update('none');
}catch(e){}
}
function autoY(){
var datasets=[chart.data.datasets[0],chart.data.datasets[1],chart.data.datasets[2]];
var fullData=[];
datasets.forEach(function(ds){ds.data.forEach(function(p){fullData.push(p.y);});});
if(!fullData.length)return;
var fullMax=Math.max.apply(null,fullData);
var fullMin=Math.min.apply(null,fullData);
var pad=Math.max(0.3,(fullMax-fullMin)*0.2);
chart.options.scales.y.max=fullMax+pad;
chart.options.scales.y.min=fullMin-pad;
var ann=chart.options.plugins.annotation.annotations;
ann.top.yMin=ann.top.yMax=fullMax;
ann.top.label.content='최고 '+fullMax.toFixed(2)+'%';
ann.bot.yMin=ann.bot.yMax=fullMin;
ann.bot.label.content='최저 '+fullMin.toFixed(2)+'%';
}
async function briefing(){
el.modal.classList.add('show');
el.body.innerHTML='<div style="text-align:center;padding:30px;"><div style="color:#64ffda;font-size:14px;">분석중...</div></div>';
try{
var marketAll=await getMarkets();
var krw=marketAll.filter(function(m){return m.market.startsWith('KRW-')&&!['KRW-BTC','KRW-ETH'].includes(m.market);});
var tickers=await fetchJson(API_BASE+'/ticker?markets='+krw.slice(0,50).map(function(m){return m.market;}).join(','));
var topAlts=tickers.sort(function(a,b){return b.acc_trade_price_24h-a.acc_trade_price_24h;}).slice(0,15);
var analyzeRange=async function(api,count,label){
var urls=topAlts.map(function(a){return API_BASE+'/candles/'+api+'?market='+a.market+'&count='+count;});
var results=await Promise.all(urls.map(function(url){return fetchJson(url).catch(function(){return null;});}));
var altResults=[];
results.forEach(function(candles,i){
if(!candles||candles.length<3)return;
var rev=candles.slice().reverse();
var first=rev[0].trade_price;
var last=rev[rev.length-1].trade_price;
var change=((last-first)/first)*100;
altResults.push({market:topAlts[i].market.replace('KRW-',''),change:change});
});
if(altResults.length===0)return null;
var avgChange=altResults.reduce(function(s,a){return s+a.change;},0)/altResults.length;
var upCnt=altResults.filter(function(a){return a.change>0.3;}).length;
var downCnt=altResults.filter(function(a){return a.change<-0.3;}).length;
var neutralCnt=altResults.length-upCnt-downCnt;
var upRatio=(upCnt/altResults.length*100).toFixed(0);
var downRatio=(downCnt/altResults.length*100).toFixed(0);
var trend,trendClass;
if(avgChange>2){trend='강한 상승';trendClass='strongUp';}
else if(avgChange>0.5){trend='상승';trendClass='up';}
else if(avgChange>0){trend='약상승';trendClass='weakUp';}
else if(avgChange>-0.5){trend='약하락';trendClass='weakDown';}
else if(avgChange>-2){trend='하락';trendClass='down';}
else{trend='강한 하락';trendClass='strongDown';}
var sorted=altResults.slice().sort(function(a,b){return b.change-a.change;});
return{label:label,avgChange:avgChange.toFixed(2),trend:trend,trendClass:trendClass,upCount:upCnt,downCount:downCnt,neutralCount:neutralCnt,upRatio:upRatio,downRatio:downRatio,topUp:sorted.slice(0,3),topDown:sorted.slice(-3).reverse()};
};
var results=await Promise.all([analyzeRange('minutes/3',10,'단기 (30분)'),analyzeRange('minutes/15',16,'중기 (4시간)'),analyzeRange('minutes/60',24,'장기 (24시간)')]);
var getTrendColor=function(tc){var c={strongUp:'#1b5e20',up:'#4caf50',weakUp:'#81c784',weakDown:'#ff8a65',down:'#f44336',strongDown:'#b71c1c'};return c[tc]||'#9e9e9e';};
var renderAnalysis=function(data,bc){
if(!data)return'<div style="padding:20px;text-align:center;color:rgba(255,255,255,0.4);">데이터 없음</div>';
var color=getTrendColor(data.trendClass);
var sign=data.avgChange>=0?'+':'';
return'<div style="background:rgba('+bc+',0.08);border:1px solid rgba('+bc+',0.3);border-radius:14px;padding:16px;margin-bottom:14px;"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:8px;"><div style="font-family:\'Orbitron\',monospace;font-size:15px;font-weight:700;color:rgb('+bc+');">'+data.label+'</div><div style="display:flex;align-items:center;gap:8px;"><span style="font-size:18px;font-weight:800;color:'+color+';">'+sign+data.avgChange+'%</span><span style="background:'+color+'22;color:'+color+';padding:4px 10px;border-radius:20px;font-size:12px;font-weight:700;">'+data.trend+'</span></div></div><div style="margin-bottom:14px;"><div style="display:flex;height:8px;border-radius:4px;overflow:hidden;background:rgba(255,255,255,0.1);"><div style="width:'+data.upRatio+'%;background:linear-gradient(90deg,#1b5e20,#4caf50);"></div><div style="width:'+(100-data.upRatio-data.downRatio)+'%;background:#9e9e9e;"></div><div style="width:'+data.downRatio+'%;background:linear-gradient(90deg,#f44336,#b71c1c);"></div></div><div style="display:flex;justify-content:space-between;margin-top:6px;font-size:11px;"><span style="color:#4caf50;">상승 '+data.upCount+'개</span><span style="color:#9e9e9e;">중립 '+data.neutralCount+'개</span><span style="color:#f44336;">하락 '+data.downCount+'개</span></div></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;"><div style="background:rgba(76,175,80,0.1);border-radius:8px;padding:10px;"><div style="font-size:10px;color:#4caf50;font-weight:700;margin-bottom:6px;">상승 TOP 3</div>'+data.topUp.map(function(a){return'<div style="display:flex;justify-content:space-between;font-size:11px;margin-bottom:3px;"><span style="color:rgba(255,255,255,0.8);">'+a.market+'</span><span style="color:#4caf50;font-weight:600;">+'+a.change.toFixed(2)+'%</span></div>';}).join('')+'</div><div style="background:rgba(244,67,54,0.1);border-radius:8px;padding:10px;"><div style="font-size:10px;color:#f44336;font-weight:700;margin-bottom:6px;">하락 TOP 3</div>'+data.topDown.map(function(a){return'<div style="display:flex;justify-content:space-between;font-size:11px;margin-bottom:3px;"><span style="color:rgba(255,255,255,0.8);">'+a.market+'</span><span style="color:#f44336;font-weight:600;">'+a.change.toFixed(2)+'%</span></div>';}).join('')+'</div></div></div>';
};
var html='<div style="margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid rgba(255,255,255,0.1);"><div style="font-size:12px;color:rgba(255,255,255,0.5);">분석 시각: '+new Date().toLocaleString('ko-KR')+'</div></div>';
html+=renderAnalysis(results[0],'100,255,218');
html+=renderAnalysis(results[1],'98,126,234');
html+=renderAnalysis(results[2],'247,147,26');
el.body.innerHTML=html;
}catch(e){el.body.innerHTML='<div style="padding:30px;text-align:center;color:#f44336;">분석 실패: '+e.message+'</div>';}
}
function wire(){
el.alert.addEventListener('change',function(e){alertOn=e.target.checked;});
el.controls.addEventListener('click',function(e){
if(!e.target.classList.contains('btn')||e.target.classList.contains('active'))return;
Array.from(el.controls.children).forEach(function(b){b.classList.remove('active');});
e.target.classList.add('active');
active=e.target.dataset.period;
clearInterval(fullUpdateTimer);clearInterval(streamTimer);
fullUpdate().then(function(){
fullUpdateTimer=setInterval(fullUpdate,60000);
streamTimer=setInterval(streamUpdate,2000);
});
});
el.brief.addEventListener('click',briefing);
el.close.addEventListener('click',function(){el.modal.classList.remove('show');});
el.manual.addEventListener('click',function(){el.manualModal.classList.add('show');});
el.manualClose.addEventListener('click',function(){el.manualModal.classList.remove('show');});
window.addEventListener('resize',function(){if(chart)chart.resize();});
}
async function updateAltSignals(){
try{
var grid=document.getElementById('signalGrid');
if(!grid)return;
var marketAll=await getMarkets();
var krw=marketAll.filter(function(m){return m.market.startsWith('KRW-')&&!['KRW-BTC','KRW-ETH'].includes(m.market);});
var tickers=await fetchJson(API_BASE+'/ticker?markets='+krw.slice(0,80).map(function(m){return m.market;}).join(','));
var top30=tickers.sort(function(a,b){return b.acc_trade_price_24h-a.acc_trade_price_24h;}).slice(0,30);
var urls=top30.map(function(a){return API_BASE+'/candles/minutes/3?market='+a.market+'&count=20';});
var allCandles=await Promise.all(urls.map(function(url){return fetchJson(url).catch(function(){return null;});}));
var getColor=function(change){
if(change>=3)return{bg:'rgba(27,94,32,0.5)',text:'#1b5e20',border:'#1b5e20'};
if(change>=2)return{bg:'rgba(46,125,50,0.4)',text:'#2e7d32',border:'#2e7d32'};
if(change>=1)return{bg:'rgba(76,175,80,0.35)',text:'#4caf50',border:'#4caf50'};
if(change>=0.5)return{bg:'rgba(129,199,132,0.3)',text:'#81c784',border:'#81c784'};
if(change>=0.3)return{bg:'rgba(165,214,167,0.25)',text:'#a5d6a7',border:'#a5d6a7'};
if(change>-0.3)return{bg:'rgba(255,235,59,0.25)',text:'#ffeb3b',border:'#fdd835'};
if(change>-0.5)return{bg:'rgba(255,183,77,0.25)',text:'#ffb74d',border:'#ffa726'};
if(change>-1)return{bg:'rgba(255,138,101,0.3)',text:'#ff8a65',border:'#ff7043'};
if(change>-2)return{bg:'rgba(244,67,54,0.35)',text:'#f44336',border:'#f44336'};
if(change>-3)return{bg:'rgba(211,47,47,0.4)',text:'#d32f2f',border:'#d32f2f'};
return{bg:'rgba(183,28,28,0.5)',text:'#b71c1c',border:'#b71c1c'};
};
var html='';
allCandles.forEach(function(candles,i){
if(!candles||candles.length<5)return;
var rev=candles.slice().reverse();
var first=rev[0].trade_price;
var last=rev[rev.length-1].trade_price;
var change=((last-first)/first)*100;
var color=getColor(change);
var symbol=top30[i].market.replace('KRW-','');
html+='<div style="background:'+color.bg+';border:1px solid '+color.border+'55;border-radius:5px;padding:5px 3px;text-align:center;min-width:0;"><div style="font-size:9px;font-weight:700;color:'+color.text+';margin-bottom:1px;overflow:hidden;text-overflow:ellipsis;">'+symbol+'</div><div style="font-size:8px;color:'+color.text+';opacity:0.9;">'+(change>=0?'+':'')+change.toFixed(1)+'%</div></div>';
});
grid.innerHTML=html||'<div style="text-align:center;color:rgba(255,255,255,0.3);font-size:11px;padding:8px;grid-column:1/-1;">데이터 없음</div>';
}catch(e){}
}
function start(){
initChart();
wire();
fullUpdate().then(function(){
fullUpdateTimer=setInterval(fullUpdate,60000);
streamTimer=setInterval(streamUpdate,2000);
});
updateAltSignals();
setInterval(updateAltSignals,30000);
}
start();
})();
</script>
</body>
</html>
