"""
B3 MSB Walk-Forward 검증 스크립트 (optimizer 로직 기준)
=========================================================
90일 1h 데이터 → train 60일 / test 30일 분리
파라미터: swing_window=15, atr_tp_multiple=4.0,
          breakout_buf_pct=0.1(%), trend_filter=adx20(ADX(20)>=25),
          min_swing_size_atr=0.5
비용: 수수료 0.12% + 슬리피지 0.05% = 0.17% RT (optimizer 기준)
통과 기준: test PF >= 1.0, train/test PF 괴리 <= 50%
"""
from __future__ import annotations

import json
import sys
from datetime import datetime, timezone
from pathlib import Path

import numpy as np

REPO_ROOT = Path(__file__).resolve().parent.parent
HIST_DIR = REPO_ROOT / "quant_runtime" / "historical"

SYMBOLS = ["BTCUSDT", "ETHUSDT", "SOLUSDT", "XRPUSDT"]

# 확정 파라미터 (gridsearch 최적, optimizer 단위계 기준)
SWING_WINDOW = 15
ATR_TP_MULT = 4.0
BREAKOUT_BUF_PCT = 0.1      # % 단위 → 실제 버퍼 = 0.1/100 = 0.001
TREND_FILTER = "adx20"      # ADX(20) >= 25
MIN_SWING_ATR = 0.5         # 스윙 크기 최소 ATR 배수

ROUND_TRIP_COST = 0.0017    # optimizer 기준 (fee 0.12% + slip 0.05%)

TOTAL_DAYS = 90
TRAIN_DAYS = 60
TEST_DAYS = 30
BARS_PER_DAY = 24


def load_arrays(symbol: str) -> dict[str, np.ndarray]:
    path = HIST_DIR / symbol / "1h.json"
    with open(path) as f:
        raw = json.load(f)
    arr = np.array(
        [[float(d["open_price"]), float(d["high_price"]),
          float(d["low_price"]), float(d["close_price"])]
         for d in raw],
        dtype=np.float64,
    )
    return {
        "open": arr[:, 0],
        "high": arr[:, 1],
        "low": arr[:, 2],
        "close": arr[:, 3],
        "timestamps": [int(d["open_time"]) for d in raw],
    }


def calc_atr(high: np.ndarray, low: np.ndarray, close: np.ndarray, period: int = 14) -> np.ndarray:
    n = len(close)
    tr = np.zeros(n)
    tr[1:] = np.maximum(
        high[1:] - low[1:],
        np.maximum(np.abs(high[1:] - close[:-1]), np.abs(low[1:] - close[:-1])),
    )
    atr = np.zeros(n)
    if n <= period:
        return atr
    atr[period] = tr[1:period + 1].mean()
    alpha = 1.0 / period
    for i in range(period + 1, n):
        atr[i] = atr[i - 1] * (1 - alpha) + tr[i] * alpha
    return atr


def calc_adx(high: np.ndarray, low: np.ndarray, close: np.ndarray, period: int = 20) -> np.ndarray:
    """Wilder 평활 ADX (optimizer 동일 구현)."""
    n = len(close)
    adx_arr = np.zeros(n)
    if n < period * 2 + 2:
        return adx_arr

    pdm = np.zeros(n)
    mdm = np.zeros(n)
    tr = np.zeros(n)
    for i in range(1, n):
        up = high[i] - high[i - 1]
        dn = low[i - 1] - low[i]
        pdm[i] = up if (up > dn and up > 0) else 0.0
        mdm[i] = dn if (dn > up and dn > 0) else 0.0
        tr[i] = max(high[i] - low[i], abs(high[i] - close[i - 1]), abs(low[i] - close[i - 1]))

    atr_w = np.zeros(n)
    pdm_w = np.zeros(n)
    mdm_w = np.zeros(n)
    atr_w[period] = tr[1:period + 1].sum()
    pdm_w[period] = pdm[1:period + 1].sum()
    mdm_w[period] = mdm[1:period + 1].sum()
    for i in range(period + 1, n):
        atr_w[i] = atr_w[i - 1] - atr_w[i - 1] / period + tr[i]
        pdm_w[i] = pdm_w[i - 1] - pdm_w[i - 1] / period + pdm[i]
        mdm_w[i] = mdm_w[i - 1] - mdm_w[i - 1] / period + mdm[i]

    with np.errstate(divide="ignore", invalid="ignore"):
        pdi = np.where(atr_w > 0, 100 * pdm_w / atr_w, 0.0)
        mdi = np.where(atr_w > 0, 100 * mdm_w / atr_w, 0.0)
        denom = pdi + mdi
        dx = np.where(denom > 0, 100 * np.abs(pdi - mdi) / denom, 0.0)

    adx_arr[2 * period] = dx[period:2 * period + 1].mean()
    alpha = 1.0 / period
    for i in range(2 * period + 1, n):
        adx_arr[i] = adx_arr[i - 1] * (1 - alpha) + dx[i] * alpha

    return adx_arr


def backtest_b3(
    high: np.ndarray,
    low: np.ndarray,
    close: np.ndarray,
) -> dict:
    """optimizer의 backtest_b3와 동일한 로직으로 백테스트."""
    atr14 = calc_atr(high, low, close, period=14)
    adx20 = calc_adx(high, low, close, period=20)
    n = len(close)

    warmup = max(SWING_WINDOW + 20, 55)

    in_pos = False
    side = ""
    entry_px = 0.0
    sl_px = 0.0
    tp_px = 0.0

    gross_profit = 0.0
    gross_loss = 0.0
    n_wins = 0
    n_total = 0
    equity = 1.0
    peak = 1.0
    max_dd = 0.0

    for i in range(warmup, n):
        cur_atr = atr14[i]
        if cur_atr <= 0:
            continue

        # 포지션 청산 체크
        if in_pos:
            if side == "long":
                if low[i] <= sl_px:
                    pnl = (sl_px / entry_px - 1.0) - ROUND_TRIP_COST
                elif high[i] >= tp_px:
                    pnl = (tp_px / entry_px - 1.0) - ROUND_TRIP_COST
                else:
                    peak = max(peak, equity)
                    max_dd = min(max_dd, (equity - peak) / peak)
                    continue
            else:  # short
                if high[i] >= sl_px:
                    pnl = (entry_px / sl_px - 1.0) - ROUND_TRIP_COST
                elif low[i] <= tp_px:
                    pnl = (entry_px / tp_px - 1.0) - ROUND_TRIP_COST
                else:
                    peak = max(peak, equity)
                    max_dd = min(max_dd, (equity - peak) / peak)
                    continue

            equity *= (1.0 + pnl)
            n_total += 1
            if pnl > 0:
                gross_profit += pnl
                n_wins += 1
            else:
                gross_loss += abs(pnl)
            peak = max(peak, equity)
            max_dd = min(max_dd, (equity - peak) / peak)
            in_pos = False

        # 신호 탐지
        sw_high = float(np.max(high[i - SWING_WINDOW:i]))
        sw_low = float(np.min(low[i - SWING_WINDOW:i]))
        sw_range = sw_high - sw_low

        # 최소 스윙 크기 필터
        if sw_range < MIN_SWING_ATR * cur_atr:
            continue

        buf = BREAKOUT_BUF_PCT / 100.0
        cc = close[i]
        long_sig = cc > sw_high * (1.0 + buf)
        short_sig = cc < sw_low * (1.0 - buf)

        # ADX 필터 (ADX(20) >= 25)
        if adx20[i] < 25.0:
            long_sig = False
            short_sig = False

        if long_sig and not short_sig:
            ep = cc
            sl = sw_low
            if ep <= sl:
                continue
            tp = ep + ATR_TP_MULT * cur_atr
            in_pos = True
            side = "long"
            entry_px, sl_px, tp_px = ep, sl, tp

        elif short_sig and not long_sig:
            ep = cc
            sl = sw_high
            if ep >= sl:
                continue
            tp = ep - ATR_TP_MULT * cur_atr
            in_pos = True
            side = "short"
            entry_px, sl_px, tp_px = ep, sl, tp

    if n_total == 0:
        return {"pf": 0.0, "win_rate": 0.0, "n_trades": 0, "mdd": 0.0,
                "gross_profit": 0.0, "gross_loss": 0.0}

    pf = (gross_profit / gross_loss) if gross_loss > 1e-12 else (999.0 if gross_profit > 0 else 0.0)
    wr = n_wins / n_total * 100.0
    return {
        "pf": round(float(pf), 4),
        "win_rate": round(float(wr), 1),
        "n_trades": n_total,
        "mdd": round(float(max_dd * 100), 1),
        "gross_profit": gross_profit,
        "gross_loss": gross_loss,
    }


def run_walkforward(symbol: str) -> dict:
    data = load_arrays(symbol)
    high, low, close = data["high"], data["low"], data["close"]
    total_bars = TOTAL_DAYS * BARS_PER_DAY   # 2160
    train_bars = TRAIN_DAYS * BARS_PER_DAY   # 1440

    if len(close) < total_bars:
        return {"symbol": symbol, "error": f"데이터 부족: {len(close)} < {total_bars}"}

    window = len(close)
    h_w = high[-total_bars:]
    l_w = low[-total_bars:]
    c_w = close[-total_bars:]

    h_tr = h_w[:train_bars]
    l_tr = l_w[:train_bars]
    c_tr = c_w[:train_bars]

    h_te = h_w[train_bars:]
    l_te = l_w[train_bars:]
    c_te = c_w[train_bars:]

    train_res = backtest_b3(h_tr, l_tr, c_tr)
    test_res = backtest_b3(h_te, l_te, c_te)

    train_pf = train_res["pf"]
    test_pf = test_res["pf"]

    if train_pf > 0 and test_pf > 0:
        pf_decay = round((1 - test_pf / train_pf) * 100, 1)
    elif train_pf == 0:
        pf_decay = 0.0
    else:
        pf_decay = 100.0

    pass_test_pf = test_pf >= 1.0
    pass_pf_decay = pf_decay <= 50.0
    passed = pass_test_pf and pass_pf_decay

    return {
        "symbol": symbol,
        "train": train_res,
        "test": test_res,
        "pf_decay_pct": pf_decay,
        "passed": passed,
        "reason": (
            "PASS" if passed
            else (
                f"FAIL: test PF {test_pf:.4f} < 1.0"
                if not pass_test_pf
                else f"FAIL: PF 괴리 {pf_decay:.1f}% > 50%"
            )
        ),
    }


def compute_current_signals(symbol: str) -> dict:
    """최근 50+SWING_WINDOW봉으로 현재 ADX, swing level, 신호 계산."""
    data = load_arrays(symbol)
    high, low, close = data["high"], data["low"], data["close"]
    if len(close) < 100:
        return {"symbol": symbol, "error": "데이터 부족"}

    # 최근 200봉으로 지표 계산
    n = 200
    h = high[-n:]
    l = low[-n:]
    c = close[-n:]

    atr14 = calc_atr(h, l, c, period=14)
    adx20 = calc_adx(h, l, c, period=20)

    cur_atr = float(atr14[-1])
    cur_adx = float(adx20[-1])
    cur_close = float(c[-1])

    sw_high = float(np.max(h[-(SWING_WINDOW + 1):-1]))
    sw_low = float(np.min(l[-(SWING_WINDOW + 1):-1]))
    sw_range = sw_high - sw_low

    buf = BREAKOUT_BUF_PCT / 100.0
    long_sig = cur_close > sw_high * (1.0 + buf)
    short_sig = cur_close < sw_low * (1.0 - buf)
    adx_pass = cur_adx >= 25.0
    size_pass = sw_range >= MIN_SWING_ATR * cur_atr

    if long_sig and adx_pass and size_pass:
        signal = "LONG (진입 조건 충족)"
    elif short_sig and adx_pass and size_pass:
        signal = "SHORT (진입 조건 충족)"
    else:
        reasons = []
        if not adx_pass:
            reasons.append(f"ADX={cur_adx:.1f}<25")
        if not size_pass:
            reasons.append(f"스윙범위<{MIN_SWING_ATR}ATR")
        if not long_sig and not short_sig:
            reasons.append("돌파 없음")
        signal = f"없음 ({', '.join(reasons)})"

    return {
        "symbol": symbol,
        "close": round(cur_close, 4),
        "adx": round(cur_adx, 2),
        "atr": round(cur_atr, 4),
        "swing_high": round(sw_high, 4),
        "swing_low": round(sw_low, 4),
        "signal": signal,
    }


def main() -> None:
    print("=" * 65)
    print("B3 MSB Walk-Forward 검증 (optimizer 로직 기준)")
    print(f"파라미터: swing={SWING_WINDOW}, atr_tp={ATR_TP_MULT}x, buf={BREAKOUT_BUF_PCT}%, ADX(20)>=25, min_swing={MIN_SWING_ATR}ATR")
    print(f"비용: {ROUND_TRIP_COST*100:.2f}% RT (fee 0.12% + slip 0.05%)")
    print(f"기간: 90d (train 60d / test 30d) — 최근 90일")
    print("=" * 65)

    all_pass = True
    results = []

    print("\n[1/2] Walk-Forward 검증")
    for sym in SYMBOLS:
        r = run_walkforward(sym)
        results.append(r)

        if "error" in r:
            print(f"\n[{sym}] ERROR: {r['error']}")
            all_pass = False
            continue

        tr = r["train"]
        te = r["test"]
        print(f"\n[{sym}]")
        print(f"  Train(60d): {tr['n_trades']:3d}tr, PF={tr['pf']:.3f}, WR={tr['win_rate']:.1f}%, MDD={tr['mdd']:.1f}%")
        print(f"  Test (30d): {te['n_trades']:3d}tr, PF={te['pf']:.3f}, WR={te['win_rate']:.1f}%, MDD={te['mdd']:.1f}%")
        print(f"  PF 괴리: {r['pf_decay_pct']:.1f}%  → {r['reason']}")

        if not r["passed"]:
            all_pass = False

    print("\n" + "=" * 65)
    overall = "ALL PASS" if all_pass else "일부 심볼 통과 실패"
    print(f"Walk-Forward 종합: {overall}")
    print("=" * 65)

    # 현재 시장 신호
    print("\n[2/2] 현재 시장 신호 (최근 15봉 스윙 기준)")
    signal_results = []
    for sym in SYMBOLS:
        s = compute_current_signals(sym)
        signal_results.append(s)
        if "error" in s:
            print(f"  {sym}: {s['error']}")
        else:
            print(f"  {sym}: 가격={s['close']}, ADX={s['adx']:.1f}, ATR={s['atr']:.4f}")
            print(f"         SwingHigh={s['swing_high']}, SwingLow={s['swing_low']}")
            print(f"         신호: {s['signal']}")

    # JSON 저장
    out_path = REPO_ROOT / "quant_runtime" / "output" / "b3_walkforward_result.json"
    out_path.parent.mkdir(parents=True, exist_ok=True)
    with open(out_path, "w") as f:
        json.dump({
            "run_at": datetime.now(timezone.utc).isoformat(),
            "params": {
                "swing_window": SWING_WINDOW,
                "atr_tp_multiple": ATR_TP_MULT,
                "breakout_buf_pct": BREAKOUT_BUF_PCT,
                "adx_period": 20,
                "adx_threshold": 25.0,
                "min_swing_atr": MIN_SWING_ATR,
                "round_trip_cost": ROUND_TRIP_COST,
            },
            "walkforward": results,
            "current_signals": signal_results,
            "overall_pass": all_pass,
        }, f, indent=2)
    print(f"\n결과 저장: {out_path}")
    sys.exit(0 if all_pass else 1)


if __name__ == "__main__":
    main()
